{
  "id": "javascript",
  "name": "JavaScript",
  "extensions": [
    ".js",
    ".mjs",
    ".cjs",
    ".jsx"
  ],
  "lineComment": "//",
  "blockComment": {
    "start": "/*",
    "end": "*/"
  },
  "stringQuotes": [
    "\"",
    "'",
    "`"
  ],
  "keywords": [
    "async",
    "await",
    "break",
    "case",
    "catch",
    "class",
    "const",
    "continue",
    "debugger",
    "default",
    "delete",
    "do",
    "else",
    "export",
    "extends",
    "finally",
    "for",
    "from",
    "function",
    "if",
    "import",
    "in",
    "instanceof",
    "let",
    "new",
    "of",
    "return",
    "static",
    "super",
    "switch",
    "throw",
    "try",
    "typeof",
    "var",
    "void",
    "while",
    "with",
    "yield"
  ],
  "literals": [
    "true",
    "false",
    "null",
    "undefined",
    "NaN",
    "Infinity"
  ],
  "builtins": [
    "Array",
    "Boolean",
    "Date",
    "Error",
    "JSON",
    "Map",
    "Math",
    "Number",
    "Object",
    "Promise",
    "RegExp",
    "Set",
    "String",
    "console",
    "document",
    "window",
    "fetch",
    "localStorage",
    "sessionStorage"
  ],
  "operators": [
    "=>",
    "===",
    "!==",
    "==",
    "!=",
    "<=",
    ">=",
    "&&",
    "||",
    "??",
    "?.",
    "++",
    "--",
    "+=",
    "-=",
    "*=",
    "/=",
    "**",
    "+",
    "-",
    "*",
    "/",
    "%",
    "=",
    "<",
    ">",
    "!",
    "?",
    "&",
    "|",
    "^",
    "~",
    ":"
  ],
  "highlightNumbers": true,
  "caseSensitive": true
}
