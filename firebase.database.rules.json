{
  "rules": {
    ".read": false,
    ".write": false,
    "presence": {
      "v1": {
        "clients": {
          ".read": true,
          "$visitorId": {
            "$connectionId": {
              ".write": "newData.val() == null || (newData.hasChildren(['module','auth','at']) && newData.child('at').isNumber() && newData.child('at').val() >= now - 60000 && newData.child('at').val() <= now + 10000)",
              ".validate": "newData.val() == null || newData.hasChildren(['module','auth','at'])",
              "module": {
                ".validate": "newData.isString() && (newData.val() == 'game' || newData.val() == 'lcs' || newData.val() == 'dai' || newData.val() == 'site')"
              },
              "auth": {
                ".validate": "newData.isString() && (newData.val() == 'signed_in' || newData.val() == 'guest')"
              },
              "at": {
                ".validate": "newData.isNumber()"
              },
              "$other": {
                ".validate": false
              }
            }
          }
        }
      }
    }
  }
}
