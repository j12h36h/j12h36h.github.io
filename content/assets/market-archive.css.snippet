
/* Immutable holdings + recoverable Asset Archive */
.inventory-view-tabs{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-top:10px}.inventory-view-tabs button{min-height:30px;border:1px solid rgba(131,224,227,.1);background:rgba(0,8,10,.55);color:#607f82;font:800 6px/1 var(--mono);letter-spacing:.1em;cursor:pointer}.inventory-view-tabs button b{margin-left:4px;color:#8bbfc2}.inventory-view-tabs button.is-active{border-color:rgba(151,239,241,.32);background:rgba(131,224,227,.08);color:#e5f8f8}.inventory-archive-note{margin:8px 1px 0;color:#4f7275;font:700 6px/1.45 var(--mono);letter-spacing:.08em}.inventory-item.is-archived{border-style:dashed;background:rgba(2,9,11,.35)}.inventory-item.is-archived .inventory-preview{opacity:.58}.inventory-locked-tint{display:grid;grid-template-columns:auto 16px 1fr;align-items:center;gap:6px;margin-top:7px;color:#59777a;font:700 6px/1 var(--mono);letter-spacing:.07em}.inventory-locked-tint i{display:block;width:14px;height:14px;border:1px solid rgba(255,255,255,.22);background:var(--holding-tint)}.inventory-locked-tint b{overflow:hidden;color:#8eaaac;font:700 6px/1 var(--mono);text-overflow:ellipsis}.inventory-archive,.inventory-restore{width:100%;min-height:25px;margin-top:8px;border:1px solid rgba(131,224,227,.14);background:rgba(131,224,227,.04);color:#769a9d;font:800 6px/1 var(--mono);letter-spacing:.1em;cursor:pointer}.inventory-archive:hover{border-color:rgba(239,134,148,.35);color:#ef9aa5;background:rgba(122,30,44,.08)}.inventory-restore{border-color:rgba(123,230,166,.22);color:#83dba5;background:rgba(54,139,88,.06)}.inventory-restore:hover{border-color:rgba(123,230,166,.42);color:#b4f2ca;background:rgba(54,139,88,.11)}
