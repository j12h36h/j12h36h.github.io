rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function ownAuth(uid) { return signedIn() && request.auth.uid == uid; }
    function hasPrivateAccount() { return signedIn() && exists(/databases/$(database)/documents/privateAccounts/$(request.auth.uid)); }
    function callerProfileId() { return get(/databases/$(database)/documents/privateAccounts/$(request.auth.uid)).data.publicProfileId; }
    function isCallerProfile(profileId) { return hasPrivateAccount() && callerProfileId() == profileId; }
    function validPublicId(id) { return id is string && id.size() == 36 && id.matches('[0-9a-fA-F-]{36}'); }
    function validReasoning(t) { return t in ['unclassified','observation','premise','deduction','assumption','hypothesis','question']; }
    function validKind(k) { return k in ['idea','problem','project']; }
    function validTargetType(t) { return t in ['post','object']; }
    function validFollowTargetType(t) { return t in ['object','profile']; }
    function validRelation(r) { return r in ['related to','context for','supports','challenges','solves','depends on','inspired by']; }
    function validChannelType(t) { return t in ['discussion','ideas','problems','projects','research','releases','announcements']; }
    function validLfgPurpose(p) { return p in ['play','create','share']; }
    function validRequestStatus(s) { return s in ['pending','accepted','declined','cancelled']; }
    function validStatus(s) { return s in ['founder','moderator','member','timeout']; }
    function validStatusScope(s) { return s in ['global','discussion_post','discussion_object','project']; }
    function profileExists(id) { return validPublicId(id) && exists(/databases/$(database)/documents/publicProfiles/$(id)); }
    function isDeleted(data) { return data.get('deleted', false) == true; }
    function validOptionalTimestamp(value) { return value == null || value is timestamp; }

    // One-time founder bootstrap. This document is created manually in Firebase Console and is never client-readable.
    // Path: systemPrivate/founder  Fields: { profileId: <random LCS public profile ID> }
    function isBootstrapFounder(profileId) {
      return validPublicId(profileId)
        && exists(/databases/$(database)/documents/systemPrivate/founder)
        && get(/databases/$(database)/documents/systemPrivate/founder).data.profileId == profileId;
    }

    function statusDocId(scopeType, scopeId, status, profileId) {
      return scopeType + '__' + scopeId + '__' + status + '__' + profileId;
    }
    function hasActiveStatus(profileId, status, scopeType, scopeId) {
      let id = statusDocId(scopeType, scopeId, status, profileId);
      let path = /databases/$(database)/documents/statusAssignments/$(id);
      return exists(path)
        && get(path).data.active == true
        && (get(path).data.expiresAt == null || get(path).data.expiresAt > request.time);
    }
    function callerIsFounder() {
      // Root authority comes only from the private bootstrap record. A public Founder badge alone never grants authority.
      return hasPrivateAccount() && isBootstrapFounder(callerProfileId());
    }
    function callerIsGlobalModerator() {
      return hasPrivateAccount() && (callerIsFounder() || hasActiveStatus(callerProfileId(), 'moderator', 'global', '_'));
    }
    function callerIsTimedOutGlobal() {
      return hasPrivateAccount() && !callerIsFounder() && hasActiveStatus(callerProfileId(), 'timeout', 'global', '_');
    }
    function callerCanContribute() { return hasPrivateAccount() && !callerIsTimedOutGlobal(); }
    function callerModerationEnabled() { return callerIsFounder() || (callerIsGlobalModerator() && !callerIsTimedOutGlobal()); }
    function callerOwnsProject(projectId) {
      let path = /databases/$(database)/documents/publicObjects/$(projectId);
      return hasPrivateAccount()
        && exists(path)
        && get(path).data.kind == 'project'
        && get(path).data.authorProfileId == callerProfileId();
    }
    function callerModeratesProject(projectId) {
      return callerModerationEnabled()
        || (hasPrivateAccount() && !callerIsTimedOutGlobal()
          && (callerOwnsProject(projectId) || hasActiveStatus(callerProfileId(), 'moderator', 'project', projectId)));
    }
    function callerModeratesScope(scopeType, scopeId) {
      return callerModerationEnabled()
        || (scopeType == 'project' && callerModeratesProject(scopeId))
        || (hasPrivateAccount() && !callerIsTimedOutGlobal() && hasActiveStatus(callerProfileId(), 'moderator', scopeType, scopeId));
    }
    function profileTimedOutInScope(profileId, scopeType, scopeId) {
      return hasActiveStatus(profileId, 'timeout', scopeType, scopeId);
    }
    function callerTimedOutForDiscussion(targetType, targetId) {
      let scopeType = targetType == 'post' ? 'discussion_post' : 'discussion_object';
      let projectTimeout = targetType == 'object'
        && exists(/databases/$(database)/documents/publicObjects/$(targetId))
        && get(/databases/$(database)/documents/publicObjects/$(targetId)).data.kind == 'project'
        && profileTimedOutInScope(callerProfileId(), 'project', targetId);
      return callerIsTimedOutGlobal() || profileTimedOutInScope(callerProfileId(), scopeType, targetId) || projectTimeout;
    }
    function callerModeratesDiscussion(targetType, targetId) {
      let scopeType = targetType == 'post' ? 'discussion_post' : 'discussion_object';
      let projectModerator = targetType == 'object'
        && exists(/databases/$(database)/documents/publicObjects/$(targetId))
        && get(/databases/$(database)/documents/publicObjects/$(targetId)).data.kind == 'project'
        && callerModeratesScope('project', targetId);
      return callerModeratesScope(scopeType, targetId) || projectModerator;
    }
    function callerModeratesObject(objectId, data) {
      return callerModerationEnabled() || (data.kind == 'project' && callerModeratesProject(objectId));
    }

    function canPublishToChannel(data) {
      let channelPath = /databases/$(database)/documents/publicChannels/$(data.channelId);
      return data.spaceId == 'open-commons'
        || (exists(channelPath)
          && get(channelPath).data.spaceId == data.spaceId
          && (get(channelPath).data.type != 'announcements'
            || get(channelPath).data.ownerProfileId == callerProfileId()
            || callerModerationEnabled()));
    }

    function moderationLogMatches(actionId, targetCollection, targetId, action) {
      let path = /databases/$(database)/documents/moderationLogs/$(actionId);
      return actionId is string && actionId.size() > 8
        && getAfter(path).data.actorProfileId == callerProfileId()
        && getAfter(path).data.targetCollection == targetCollection
        && getAfter(path).data.targetId == targetId
        && getAfter(path).data.action == action;
    }

    // PRIVATE AUTH BOUNDARY. Firebase Auth UID exists only as this private document path.
    match /privateAccounts/{uid} {
      allow read: if ownAuth(uid);
      allow create: if ownAuth(uid)
        && request.resource.data.keys().hasOnly(['publicProfileId','securityVersion','createdAt'])
        && validPublicId(request.resource.data.publicProfileId)
        && !exists(/databases/$(database)/documents/publicProfiles/$(request.resource.data.publicProfileId))
        && request.resource.data.securityVersion in [5,6]
        && request.resource.data.createdAt is timestamp;
      allow update: if ownAuth(uid)
        && request.resource.data.keys().hasOnly(['publicProfileId','securityVersion','createdAt'])
        && request.resource.data.publicProfileId == resource.data.publicProfileId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.securityVersion in [5,6];
      allow delete: if false;
    }

    // Never client-readable/writable. Firebase Console/Admin SDK only.
    match /systemPrivate/{id} { allow read, write: if false; }

    // Authority probe: contains no readable data. A get is authorized only for the configured root Founder.
    // The frontend uses the permission result to avoid trusting public Founder badges as authority.
    match /systemAuthority/{id} {
      allow get: if id == 'founderProbe' && callerIsFounder();
      allow list, create, update, delete: if false;
    }

    function validProfile(data) {
      return data.keys().hasOnly(['displayName','bio','avatarJson','createdAt','updatedAt'])
        && data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 40
        && data.bio is string && data.bio.size() <= 240
        && (!data.keys().hasAny(['avatarJson']) || (data.avatarJson is string && data.avatarJson.size() <= 32000))
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }
    match /publicProfiles/{profileId} {
      allow read: if true;
      allow create: if isCallerProfile(profileId) && validProfile(request.resource.data);
      allow update: if isCallerProfile(profileId)
        && request.resource.data.createdAt == resource.data.createdAt
        && validProfile(request.resource.data);
      allow delete: if false;
    }

    // UNIFIED STATUS SYSTEM. Founder/Moderator/Member are public badges; Timeout is private to target + moderators. Project Member grants affiliation only, never moderation authority.
    function validStatusAssignment(data) {
      return data.keys().hasOnly(['profileId','status','scopeType','scopeId','visibility','active','expiresAt','reason','grantedByProfileId','createdAt','updatedAt','revokedAt','revokedByProfileId','lastActionId'])
        && validPublicId(data.profileId) && profileExists(data.profileId)
        && validStatus(data.status) && validStatusScope(data.scopeType)
        && data.scopeId is string && data.scopeId.size() > 0 && data.scopeId.size() <= 180
        && ((data.scopeType == 'global' && data.scopeId == '_') || data.scopeType != 'global')
        && (data.status != 'founder' || data.scopeType == 'global')
        && (data.status != 'member' || data.scopeType == 'project')
        && data.visibility == (data.status == 'timeout' ? 'private' : 'public')
        && data.active is bool
        && validOptionalTimestamp(data.expiresAt)
        && data.reason is string && data.reason.size() <= 240
        && (data.status in ['timeout','member'] || data.reason == '')
        && validPublicId(data.grantedByProfileId)
        && data.createdAt is timestamp && data.updatedAt is timestamp
        && validOptionalTimestamp(data.revokedAt)
        && data.revokedByProfileId is string && (data.revokedByProfileId == '' || validPublicId(data.revokedByProfileId))
        && data.lastActionId is string && data.lastActionId.size() <= 80;
    }
    function canCreateStatus(status, scopeType, scopeId) {
      return (status == 'moderator' && (callerIsFounder() || (scopeType == 'project' && callerModeratesProject(scopeId))))
        || (status == 'member' && scopeType == 'project' && callerModeratesProject(scopeId))
        || (status == 'timeout' && (callerModerationEnabled() || callerModeratesScope(scopeType, scopeId)));
    }
    function canChangeStatus(status, scopeType, scopeId) {
      // Root Founder can clean up any assignment. Project creators/moderators can manage Project Moderator + Timeout inside their project.
      return callerIsFounder()
        || (status == 'moderator' && scopeType == 'project' && callerModeratesProject(scopeId))
        || (status == 'member' && scopeType == 'project' && callerModeratesProject(scopeId))
        || (status == 'timeout' && (callerModerationEnabled() || callerModeratesScope(scopeType, scopeId)));
    }
    function isFounderBootstrapGrant(data) {
      return data.profileId == callerProfileId()
        && data.status == 'founder' && data.scopeType == 'global' && data.scopeId == '_'
        && isBootstrapFounder(callerProfileId());
    }
    match /statusAssignments/{assignmentId} {
      allow get: if resource.data.visibility == 'public'
        || isCallerProfile(resource.data.profileId)
        || callerModerationEnabled()
        || callerModeratesScope(resource.data.scopeType, resource.data.scopeId);
      allow list: if resource.data.visibility == 'public'
        || isCallerProfile(resource.data.profileId)
        || callerModerationEnabled()
        || callerModeratesScope(resource.data.scopeType, resource.data.scopeId);
      allow create: if hasPrivateAccount()
        && assignmentId == statusDocId(request.resource.data.scopeType, request.resource.data.scopeId, request.resource.data.status, request.resource.data.profileId)
        && validStatusAssignment(request.resource.data)
        && request.resource.data.active == true
        && request.resource.data.revokedAt == null
        && request.resource.data.revokedByProfileId == ''
        && request.resource.data.grantedByProfileId == callerProfileId()
        && ((isFounderBootstrapGrant(request.resource.data) && request.resource.data.lastActionId == 'bootstrap')
          || (canCreateStatus(request.resource.data.status, request.resource.data.scopeType, request.resource.data.scopeId)
            && moderationLogMatches(request.resource.data.lastActionId, 'statusAssignments', assignmentId, 'status_grant')));
      allow update: if hasPrivateAccount()
        && request.resource.data.profileId == resource.data.profileId
        && request.resource.data.status == resource.data.status
        && request.resource.data.scopeType == resource.data.scopeType
        && request.resource.data.scopeId == resource.data.scopeId
        && request.resource.data.visibility == resource.data.visibility
        && request.resource.data.createdAt == resource.data.createdAt
        && validStatusAssignment(request.resource.data)
        && canChangeStatus(resource.data.status, resource.data.scopeType, resource.data.scopeId)
        && !(resource.data.status == 'founder' && resource.data.scopeType == 'global' && isBootstrapFounder(resource.data.profileId) && request.resource.data.active == false)
        && request.resource.data.updatedAt == request.time
        && moderationLogMatches(request.resource.data.lastActionId, 'statusAssignments', assignmentId, request.resource.data.active ? 'status_grant' : 'status_revoke');
      allow delete: if false;
    }

    function validModerationLog(data) {
      return data.keys().hasOnly(['actorProfileId','targetProfileId','targetCollection','targetId','action','scopeType','scopeId','reason','snapshot','createdAt'])
        && validPublicId(data.actorProfileId) && data.actorProfileId == callerProfileId()
        && data.targetProfileId is string && (data.targetProfileId == '' || validPublicId(data.targetProfileId))
        && data.targetCollection in ['publicPosts','publicObjects','publicComments','publicLfg','statusAssignments']
        && data.targetId is string && data.targetId.size() > 0 && data.targetId.size() <= 1500
        && data.action in ['remove','restore','author_remove','author_restore','status_grant','status_revoke']
        && validStatusScope(data.scopeType)
        && data.scopeId is string && data.scopeId.size() > 0 && data.scopeId.size() <= 180
        && data.reason is string && data.reason.size() <= 240
        && data.snapshot is map
        && data.createdAt == request.time;
    }
    function authorLogMatchesTarget(logId, data) {
      let targetPath = /databases/$(database)/documents/$(data.targetCollection)/$(data.targetId);
      return data.action in ['author_remove','author_restore']
        && data.actorProfileId == data.targetProfileId
        && isCallerProfile(data.targetProfileId)
        && getAfter(targetPath).data.authorProfileId == callerProfileId()
        && getAfter(targetPath).data.get('moderationActionId','') == logId
        && ((data.action == 'author_remove' && getAfter(targetPath).data.get('deleted',false) == true)
          || (data.action == 'author_restore' && getAfter(targetPath).data.get('deleted',false) == false));
    }
    match /moderationLogs/{logId} {
      allow read: if callerModerationEnabled()
        || callerModeratesScope(resource.data.scopeType, resource.data.scopeId);
      allow create: if validModerationLog(request.resource.data)
        && ((request.resource.data.action in ['author_remove','author_restore']
            && authorLogMatchesTarget(logId, request.resource.data))
          || (request.resource.data.action in ['remove','restore','status_grant','status_revoke']
            && (callerModerationEnabled()
              || callerModeratesScope(request.resource.data.scopeType, request.resource.data.scopeId))));
      allow update, delete: if false;
    }

    function moderationFieldsOnlyChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted','deletedAt','deletedByProfileId','deleteReason','moderationActionId','updatedAt']);
    }
    function authorHistoryLogMatches(actionId, targetCollection, targetId, action) {
      let path = /databases/$(database)/documents/moderationLogs/$(actionId);
      return actionId is string && actionId.size() > 8
        && getAfter(path).data.actorProfileId == callerProfileId()
        && getAfter(path).data.targetProfileId == callerProfileId()
        && getAfter(path).data.targetCollection == targetCollection
        && getAfter(path).data.targetId == targetId
        && getAfter(path).data.action == action;
    }
    function selfDeleteFieldsValid(authorProfileId, targetCollection, targetId) {
      return isCallerProfile(authorProfileId)
        && moderationFieldsOnlyChanged()
        && request.resource.data.get('deleted', false) == true
        && resource.data.get('deleted', false) == false
        && request.resource.data.get('deletedByProfileId','') == callerProfileId()
        && request.resource.data.get('deleteReason','') == 'Deleted by author'
        && request.resource.data.get('deletedAt', null) == request.time
        && request.resource.data.updatedAt == request.time
        && authorHistoryLogMatches(request.resource.data.get('moderationActionId',''), targetCollection, targetId, 'author_remove');
    }
    function selfRestoreFieldsValid(authorProfileId, targetCollection, targetId) {
      return isCallerProfile(authorProfileId)
        && resource.data.get('deleted', false) == true
        && resource.data.get('deletedByProfileId','') == callerProfileId()
        && resource.data.get('deleteReason','') == 'Deleted by author'
        && moderationFieldsOnlyChanged()
        && request.resource.data.get('deleted', false) == false
        && request.resource.data.get('deletedAt', null) == null
        && request.resource.data.get('deletedByProfileId','') == ''
        && request.resource.data.get('deleteReason','') == ''
        && request.resource.data.updatedAt == request.time
        && authorHistoryLogMatches(request.resource.data.get('moderationActionId',''), targetCollection, targetId, 'author_restore');
    }

    function validPost(data) {
      return data.keys().hasOnly(['text','tags','reasoningType','kind','spaceId','channelId','authorProfileId','createdAt','updatedAt','deleted','deletedAt','deletedByProfileId','deleteReason','moderationActionId'])
        && data.text is string && data.text.size() > 0 && data.text.size() <= 1200
        && data.get('tags', []) is list && data.get('tags', []).size() <= 8
        && validReasoning(data.reasoningType) && validKind(data.kind)
        && data.spaceId is string && data.spaceId.size() > 0 && data.spaceId.size() <= 128
        && data.channelId is string && data.channelId.size() > 0 && data.channelId.size() <= 128
        && validPublicId(data.authorProfileId)
        && data.createdAt is timestamp && data.updatedAt is timestamp
        && data.get('deleted', false) is bool
        && validOptionalTimestamp(data.get('deletedAt', null))
        && data.get('deletedByProfileId','') is string
        && data.get('deleteReason','') is string && data.get('deleteReason','').size() <= 240
        && data.get('moderationActionId','') is string && data.get('moderationActionId','').size() <= 80;
    }
    match /publicPosts/{postId} {
      allow get: if !isDeleted(resource.data) || isCallerProfile(resource.data.authorProfileId) || callerModeratesDiscussion('post', postId);
      allow list: if !isDeleted(resource.data) || callerModerationEnabled();
      allow create: if callerCanContribute() && isCallerProfile(request.resource.data.authorProfileId)
        && request.resource.data.get('deleted', false) == false
        && validPost(request.resource.data) && canPublishToChannel(request.resource.data);
      allow update: if validPost(request.resource.data)
        && (selfDeleteFieldsValid(resource.data.authorProfileId, 'publicPosts', postId)
          || (selfRestoreFieldsValid(resource.data.authorProfileId, 'publicPosts', postId) && !callerTimedOutForDiscussion('post', postId))
          || (callerModeratesDiscussion('post', postId)
            && moderationFieldsOnlyChanged()
            && request.resource.data.updatedAt == request.time
            && moderationLogMatches(request.resource.data.get('moderationActionId',''), 'publicPosts', postId, request.resource.data.get('deleted', false) ? 'remove' : 'restore')));
      allow delete: if false;
    }

    function validObject(data) {
      return data.keys().hasOnly(['kind','title','description','tags','spaceId','channelId','authorProfileId','createdAt','updatedAt','deleted','deletedAt','deletedByProfileId','deleteReason','moderationActionId'])
        && validKind(data.kind)
        && data.title is string && data.title.size() > 0 && data.title.size() <= 100
        && data.description is string && data.description.size() > 0 && data.description.size() <= 700
        && data.tags is list && data.tags.size() <= 8
        && data.spaceId is string && data.spaceId.size() > 0 && data.spaceId.size() <= 128
        && data.channelId is string && data.channelId.size() > 0 && data.channelId.size() <= 128
        && validPublicId(data.authorProfileId)
        && data.createdAt is timestamp && data.updatedAt is timestamp
        && data.get('deleted', false) is bool
        && validOptionalTimestamp(data.get('deletedAt', null))
        && data.get('deletedByProfileId','') is string
        && data.get('deleteReason','') is string && data.get('deleteReason','').size() <= 240
        && data.get('moderationActionId','') is string && data.get('moderationActionId','').size() <= 80;
    }
    function projectMetadataFieldsOnlyChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','description','tags','updatedAt']);
    }
    match /publicObjects/{objectId} {
      allow get: if !isDeleted(resource.data) || isCallerProfile(resource.data.authorProfileId) || callerModeratesObject(objectId, resource.data);
      allow list: if !isDeleted(resource.data) || callerModerationEnabled();
      allow create: if callerCanContribute() && isCallerProfile(request.resource.data.authorProfileId)
        && request.resource.data.get('deleted', false) == false
        && validObject(request.resource.data) && canPublishToChannel(request.resource.data);
      allow update: if validObject(request.resource.data)
        && (selfDeleteFieldsValid(resource.data.authorProfileId, 'publicObjects', objectId)
          || (selfRestoreFieldsValid(resource.data.authorProfileId, 'publicObjects', objectId) && !callerTimedOutForDiscussion('object', objectId))
          || (resource.data.kind == 'project'
            && request.resource.data.kind == 'project'
            && callerModeratesProject(objectId)
            && projectMetadataFieldsOnlyChanged()
            && request.resource.data.updatedAt == request.time)
          || (callerModeratesObject(objectId, resource.data)
            && moderationFieldsOnlyChanged()
            && request.resource.data.updatedAt == request.time
            && moderationLogMatches(request.resource.data.get('moderationActionId',''), 'publicObjects', objectId, request.resource.data.get('deleted', false) ? 'remove' : 'restore')));
      allow delete: if false;
    }

    function validSpace(data) {
      return data.keys().hasOnly(['name','description','ownerProfileId','createdAt','updatedAt'])
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 50
        && data.description is string && data.description.size() <= 240
        && validPublicId(data.ownerProfileId)
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }
    match /publicSpaces/{spaceId} {
      allow read: if true;
      allow create: if callerCanContribute() && isCallerProfile(request.resource.data.ownerProfileId) && validSpace(request.resource.data);
      allow update: if callerCanContribute() && (isCallerProfile(resource.data.ownerProfileId) || callerIsFounder())
        && request.resource.data.ownerProfileId == resource.data.ownerProfileId
        && request.resource.data.createdAt == resource.data.createdAt && validSpace(request.resource.data);
      allow delete: if false;
    }

    function validChannel(data) {
      return data.keys().hasOnly(['spaceId','name','description','type','ownerProfileId','createdAt','updatedAt'])
        && data.spaceId is string && data.spaceId.size() > 0 && data.spaceId.size() <= 128
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 40
        && data.description is string && data.description.size() <= 240
        && validChannelType(data.type) && validPublicId(data.ownerProfileId)
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }
    match /publicChannels/{channelId} {
      allow read: if true;
      allow create: if callerCanContribute()
        && exists(/databases/$(database)/documents/publicSpaces/$(request.resource.data.spaceId))
        && get(/databases/$(database)/documents/publicSpaces/$(request.resource.data.spaceId)).data.ownerProfileId == request.resource.data.ownerProfileId
        && (isCallerProfile(request.resource.data.ownerProfileId) || callerIsFounder())
        && validChannel(request.resource.data);
      allow update: if callerCanContribute()
        && (isCallerProfile(resource.data.ownerProfileId) || callerIsFounder())
        && request.resource.data.ownerProfileId == resource.data.ownerProfileId
        && request.resource.data.spaceId == resource.data.spaceId
        && request.resource.data.createdAt == resource.data.createdAt && validChannel(request.resource.data);
      allow delete: if false;
    }

    function validComment(data) {
      return data.keys().hasOnly(['targetKey','targetType','targetId','text','reasoningType','authorProfileId','createdAt','updatedAt','deleted','deletedAt','deletedByProfileId','deleteReason','moderationActionId'])
        && validTargetType(data.targetType)
        && data.targetId is string && data.targetId.size() > 0
        && data.targetKey == data.targetType + ':' + data.targetId
        && data.text is string && data.text.size() > 0 && data.text.size() <= 800
        && validReasoning(data.reasoningType) && validPublicId(data.authorProfileId)
        && data.createdAt is timestamp && data.updatedAt is timestamp
        && data.get('deleted', false) is bool
        && validOptionalTimestamp(data.get('deletedAt', null))
        && data.get('deletedByProfileId','') is string
        && data.get('deleteReason','') is string && data.get('deleteReason','').size() <= 240
        && data.get('moderationActionId','') is string && data.get('moderationActionId','').size() <= 80;
    }
    match /publicComments/{commentId} {
      // Deleted responses are retained, but are visible only to their author or authorized moderation.
      allow get: if !isDeleted(resource.data) || isCallerProfile(resource.data.authorProfileId) || callerModeratesDiscussion(resource.data.targetType, resource.data.targetId);
      allow list: if !isDeleted(resource.data) || callerModeratesDiscussion(resource.data.targetType, resource.data.targetId);
      allow create: if callerCanContribute() && !callerTimedOutForDiscussion(request.resource.data.targetType, request.resource.data.targetId)
        && isCallerProfile(request.resource.data.authorProfileId)
        && request.resource.data.get('deleted', false) == false && validComment(request.resource.data);
      allow update: if validComment(request.resource.data)
        && (selfDeleteFieldsValid(resource.data.authorProfileId, 'publicComments', commentId)
          || (selfRestoreFieldsValid(resource.data.authorProfileId, 'publicComments', commentId) && !callerTimedOutForDiscussion(resource.data.targetType, resource.data.targetId))
          || (callerModeratesDiscussion(resource.data.targetType, resource.data.targetId)
            && moderationFieldsOnlyChanged()
            && request.resource.data.updatedAt == request.time
            && moderationLogMatches(request.resource.data.get('moderationActionId',''), 'publicComments', commentId, request.resource.data.get('deleted', false) ? 'remove' : 'restore')));
      allow delete: if false;
    }

    match /publicReactions/{reactionId} {
      allow read: if true;
      allow create: if callerCanContribute() && isCallerProfile(request.resource.data.actorProfileId)
        && !callerTimedOutForDiscussion(request.resource.data.targetType, request.resource.data.targetId)
        && reactionId == request.resource.data.actorProfileId + '__' + request.resource.data.targetType + '__' + request.resource.data.targetId
        && request.resource.data.keys().hasOnly(['actorProfileId','targetType','targetId','type','createdAt'])
        && validTargetType(request.resource.data.targetType)
        && request.resource.data.targetId is string && request.resource.data.targetId.size() > 0
        && request.resource.data.type == 'helpful' && request.resource.data.createdAt is timestamp;
      allow update: if false;
      allow delete: if isCallerProfile(resource.data.actorProfileId);
    }

    match /publicFollows/{followId} {
      allow read: if true;
      allow create: if callerCanContribute() && isCallerProfile(request.resource.data.followerProfileId)
        && followId == request.resource.data.followerProfileId + '__' + request.resource.data.targetType + '__' + request.resource.data.targetId
        && request.resource.data.keys().hasOnly(['followerProfileId','targetType','targetId','createdAt'])
        && validFollowTargetType(request.resource.data.targetType)
        && request.resource.data.targetId is string && request.resource.data.targetId.size() > 0
        && (request.resource.data.targetType != 'profile' || (profileExists(request.resource.data.targetId)
          && !exists(/databases/$(database)/documents/privateBlocks/$(request.resource.data.followerProfileId + '__' + request.resource.data.targetId))
          && !exists(/databases/$(database)/documents/privateBlocks/$(request.resource.data.targetId + '__' + request.resource.data.followerProfileId))))
        && request.resource.data.createdAt is timestamp;
      allow update: if false;
      allow delete: if isCallerProfile(resource.data.followerProfileId);
    }

    match /publicConnections/{connectionId} {
      allow read: if true;
      allow create: if callerCanContribute() && isCallerProfile(request.resource.data.authorProfileId)
        && request.resource.data.keys().hasOnly(['sourceId','targetId','relation','authorProfileId','createdAt'])
        && request.resource.data.sourceId is string && request.resource.data.sourceId.size() > 0
        && request.resource.data.targetId is string && request.resource.data.targetId.size() > 0
        && request.resource.data.sourceId != request.resource.data.targetId
        && validRelation(request.resource.data.relation) && request.resource.data.createdAt is timestamp;
      allow update: if false;
      allow delete: if callerCanContribute() && isCallerProfile(resource.data.authorProfileId);
    }
    match /publicPostLinks/{linkId} {
      allow read: if true;
      allow create: if callerCanContribute() && isCallerProfile(request.resource.data.authorProfileId)
        && request.resource.data.keys().hasOnly(['postId','objectId','relation','authorProfileId','createdAt'])
        && request.resource.data.postId is string && request.resource.data.postId.size() > 0
        && request.resource.data.objectId is string && request.resource.data.objectId.size() > 0
        && validRelation(request.resource.data.relation) && request.resource.data.createdAt is timestamp;
      allow update: if false;
      allow delete: if callerCanContribute() && isCallerProfile(resource.data.authorProfileId);
    }

    function validLfg(data) {
      return data.keys().hasOnly(['purpose','title','topic','description','availability','tags','authorProfileId','status','createdAt','updatedAt','deleted','deletedAt','deletedByProfileId','deleteReason','moderationActionId'])
        && validLfgPurpose(data.purpose)
        && data.title is string && data.title.size() > 0 && data.title.size() <= 100
        && data.topic is string && data.topic.size() > 0 && data.topic.size() <= 80
        && data.description is string && data.description.size() > 0 && data.description.size() <= 700
        && data.availability is string && data.availability.size() <= 120
        && data.tags is list && data.tags.size() <= 8
        && validPublicId(data.authorProfileId)
        && data.status in ['open','closed']
        && data.createdAt is timestamp && data.updatedAt is timestamp
        && data.get('deleted', false) is bool
        && validOptionalTimestamp(data.get('deletedAt', null))
        && data.get('deletedByProfileId','') is string
        && data.get('deleteReason','') is string && data.get('deleteReason','').size() <= 240
        && data.get('moderationActionId','') is string && data.get('moderationActionId','').size() <= 80;
    }
    match /publicLfg/{lfgId} {
      // Deleted LFG listings are retained for their author/global moderation, not public discovery.
      allow get: if !isDeleted(resource.data) || isCallerProfile(resource.data.authorProfileId) || callerModerationEnabled();
      allow list: if !isDeleted(resource.data) || callerModerationEnabled();
      allow create: if callerCanContribute() && isCallerProfile(request.resource.data.authorProfileId)
        && request.resource.data.get('deleted', false) == false && validLfg(request.resource.data);
      allow update: if validLfg(request.resource.data)
        && (selfDeleteFieldsValid(resource.data.authorProfileId, 'publicLfg', lfgId)
          || (selfRestoreFieldsValid(resource.data.authorProfileId, 'publicLfg', lfgId) && !callerIsTimedOutGlobal())
          || (callerModerationEnabled() && moderationFieldsOnlyChanged()
            && request.resource.data.updatedAt == request.time
            && moderationLogMatches(request.resource.data.get('moderationActionId',''), 'publicLfg', lfgId, request.resource.data.get('deleted', false) ? 'remove' : 'restore')));
      allow delete: if false;
    }

    // PRIVATE BLOCK LIST. Safety actions remain available even during Timeout.
    match /privateBlocks/{blockId} {
      allow read: if hasPrivateAccount() && resource.data.blockerProfileId == callerProfileId();
      allow create: if isCallerProfile(request.resource.data.blockerProfileId)
        && blockId == request.resource.data.blockerProfileId + '__' + request.resource.data.blockedProfileId
        && request.resource.data.keys().hasOnly(['blockerProfileId','blockedProfileId','createdAt'])
        && profileExists(request.resource.data.blockedProfileId)
        && request.resource.data.blockerProfileId != request.resource.data.blockedProfileId
        && request.resource.data.createdAt is timestamp;
      allow update: if false;
      allow delete: if hasPrivateAccount() && resource.data.blockerProfileId == callerProfileId();
    }

    // PRIVATE SOCIAL GRAPH. Global Timeout is a site-wide read-only state, so new social requests are blocked.
    match /privateFriendRequests/{requestId} {
      allow read: if hasPrivateAccount() && (resource.data.fromProfileId == callerProfileId() || resource.data.toProfileId == callerProfileId());
      allow create: if callerCanContribute() && isCallerProfile(request.resource.data.fromProfileId)
        && (requestId == request.resource.data.fromProfileId + '__' + request.resource.data.toProfileId || requestId == request.resource.data.toProfileId + '__' + request.resource.data.fromProfileId)
        && request.resource.data.keys().hasOnly(['fromProfileId','toProfileId','status','createdAt','updatedAt'])
        && profileExists(request.resource.data.toProfileId)
        && !exists(/databases/$(database)/documents/privateBlocks/$(request.resource.data.fromProfileId + '__' + request.resource.data.toProfileId))
        && !exists(/databases/$(database)/documents/privateBlocks/$(request.resource.data.toProfileId + '__' + request.resource.data.fromProfileId))
        && request.resource.data.toProfileId != request.resource.data.fromProfileId
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is timestamp && request.resource.data.updatedAt is timestamp;
      allow update: if callerCanContribute() && hasPrivateAccount()
        && request.resource.data.fromProfileId == resource.data.fromProfileId
        && request.resource.data.toProfileId == resource.data.toProfileId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.keys().hasOnly(['fromProfileId','toProfileId','status','createdAt','updatedAt'])
        && validRequestStatus(request.resource.data.status)
        && request.resource.data.updatedAt is timestamp
        && ((resource.data.toProfileId == callerProfileId() && resource.data.status == 'pending' && request.resource.data.status in ['accepted','declined'])
          || (resource.data.fromProfileId == callerProfileId() && resource.data.status == 'pending' && request.resource.data.status == 'cancelled'));
      allow delete: if hasPrivateAccount() && (resource.data.fromProfileId == callerProfileId() || resource.data.toProfileId == callerProfileId());
    }

    match /privateFriendships/{friendshipId} {
      allow read: if hasPrivateAccount() && callerProfileId() in resource.data.members;
      allow create: if callerCanContribute()
        && (friendshipId == request.resource.data.members[0] + '__' + request.resource.data.members[1] || friendshipId == request.resource.data.members[1] + '__' + request.resource.data.members[0])
        && request.resource.data.keys().hasOnly(['members','requestId','createdAt'])
        && request.resource.data.members is list && request.resource.data.members.size() == 2
        && request.resource.data.members[0] != request.resource.data.members[1]
        && callerProfileId() in request.resource.data.members
        && request.resource.data.requestId is string && request.resource.data.requestId.size() > 0
        && request.resource.data.createdAt is timestamp
        && getAfter(/databases/$(database)/documents/privateFriendRequests/$(request.resource.data.requestId)).data.status == 'accepted'
        && getAfter(/databases/$(database)/documents/privateFriendRequests/$(request.resource.data.requestId)).data.fromProfileId in request.resource.data.members
        && getAfter(/databases/$(database)/documents/privateFriendRequests/$(request.resource.data.requestId)).data.toProfileId in request.resource.data.members;
      allow update: if false;
      allow delete: if hasPrivateAccount() && callerProfileId() in resource.data.members;
    }

    match /privateLfgRequests/{requestId} {
      allow read: if hasPrivateAccount() && (resource.data.fromProfileId == callerProfileId() || resource.data.toProfileId == callerProfileId());
      allow create: if callerCanContribute() && isCallerProfile(request.resource.data.fromProfileId)
        && requestId == request.resource.data.lfgId + '__' + request.resource.data.fromProfileId
        && request.resource.data.keys().hasOnly(['lfgId','fromProfileId','toProfileId','status','createdAt','updatedAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.fromProfileId != request.resource.data.toProfileId
        && !exists(/databases/$(database)/documents/privateBlocks/$(request.resource.data.fromProfileId + '__' + request.resource.data.toProfileId))
        && !exists(/databases/$(database)/documents/privateBlocks/$(request.resource.data.toProfileId + '__' + request.resource.data.fromProfileId))
        && request.resource.data.createdAt is timestamp && request.resource.data.updatedAt is timestamp
        && exists(/databases/$(database)/documents/publicLfg/$(request.resource.data.lfgId))
        && get(/databases/$(database)/documents/publicLfg/$(request.resource.data.lfgId)).data.authorProfileId == request.resource.data.toProfileId
        && get(/databases/$(database)/documents/publicLfg/$(request.resource.data.lfgId)).data.status == 'open';
      allow update: if callerCanContribute() && hasPrivateAccount()
        && request.resource.data.lfgId == resource.data.lfgId
        && request.resource.data.fromProfileId == resource.data.fromProfileId
        && request.resource.data.toProfileId == resource.data.toProfileId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.keys().hasOnly(['lfgId','fromProfileId','toProfileId','status','createdAt','updatedAt'])
        && validRequestStatus(request.resource.data.status)
        && request.resource.data.updatedAt is timestamp
        && ((resource.data.toProfileId == callerProfileId() && resource.data.status == 'pending' && request.resource.data.status in ['accepted','declined'])
          || (resource.data.fromProfileId == callerProfileId() && resource.data.status == 'pending' && request.resource.data.status == 'cancelled'));
      allow delete: if hasPrivateAccount() && (resource.data.fromProfileId == callerProfileId() || resource.data.toProfileId == callerProfileId());
    }

    // ============================================================
    // UNIVERSAL CREDITS
    // One wallet per public profile, shared by root Account, LCS,
    // Content, and E.R.A.S. gameplay.
    // ============================================================
    function validCreditEventType(value) { return value in ['init','slime_kill','death','market_purchase','player_transfer_out','player_transfer_in','trade','game_item_trade']; }
    function validCreditWallet(data, profileId) {
      return data.keys().hasOnly(['profileId','balance','totalEarned','totalLost','lastEventId','lastEventType','createdAt','updatedAt'])
        && data.profileId == profileId
        && data.balance is int && data.balance >= 0
        && data.totalEarned is int && data.totalEarned >= 0
        && data.totalLost is int && data.totalLost >= 0
        && data.lastEventId is string && data.lastEventId.size() <= 180
        && validCreditEventType(data.lastEventType)
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }
    function validSlimeKillCreditAction(data, action) {
      let enemyPath = /databases/$(database)/documents/gameEnemies/$(action.targetId);
      return action.actorProfileId == callerProfileId()
        && action.actionType == 'attack'
        && action.targetType == 'enemy'
        && action.status == 'resolved'
        && action.outcome == 'kill'
        && existsAfter(enemyPath)
        && getAfter(enemyPath).data.alive == false
        && getAfter(enemyPath).data.lastKillActionId == data.lastEventId
        && getAfter(enemyPath).data.killerProfileId == callerProfileId();
    }
    function validSlimeKillCredit(data) {
      let actionPath = /databases/$(database)/documents/gameActions/$(data.lastEventId);
      return data.lastEventType == 'slime_kill'
        && data.lastEventId.size() > 0
        && data.balance == resource.data.balance + 1
        && data.totalEarned == resource.data.totalEarned + 1
        && data.totalLost == resource.data.totalLost
        && existsAfter(actionPath)
        && validSlimeKillCreditAction(data, getAfter(actionPath).data);
    }
    function validDeathCreditLoss(data) {
      let lost = resource.data.balance - data.balance;
      return data.lastEventType == 'death'
        && data.lastEventId.size() > 0
        && lost >= 0 && lost <= 10
        && data.totalEarned == resource.data.totalEarned
        && data.totalLost == resource.data.totalLost + lost;
    }
    function validDirectCreditTransferWallet(data, profileId) {
      let transferPath = /databases/$(database)/documents/creditTransfers/$(data.lastEventId);
      return data.lastEventId.size() > 0
        && !exists(transferPath)
        && existsAfter(transferPath)
        && getAfter(transferPath).data.fromProfileId == callerProfileId()
        && getAfter(transferPath).data.amount is int
        && getAfter(transferPath).data.amount > 0
        && ((profileId == getAfter(transferPath).data.fromProfileId
            && data.lastEventType == 'player_transfer_out'
            && data.balance == resource.data.balance - getAfter(transferPath).data.amount)
          || (profileId == getAfter(transferPath).data.toProfileId
            && data.lastEventType == 'player_transfer_in'
            && data.balance == resource.data.balance + getAfter(transferPath).data.amount))
        && data.totalEarned == resource.data.totalEarned
        && data.totalLost == resource.data.totalLost;
    }
    function validPlayerTradeWallet(data, profileId) {
      let settlementPath = /databases/$(database)/documents/tradeSettlements/$(data.lastEventId);
      return data.lastEventType == 'trade'
        && data.lastEventId.size() > 0
        && !exists(settlementPath) && existsAfter(settlementPath)
        && getAfter(settlementPath).data.initiatorProfileId == callerProfileId()
        && data.totalEarned == resource.data.totalEarned
        && data.totalLost == resource.data.totalLost
        && ((profileId == getAfter(settlementPath).data.initiatorProfileId
            && data.balance == resource.data.balance - getAfter(settlementPath).data.initiatorCredits + getAfter(settlementPath).data.recipientCredits)
          || (profileId == getAfter(settlementPath).data.recipientProfileId
            && data.balance == resource.data.balance - getAfter(settlementPath).data.recipientCredits + getAfter(settlementPath).data.initiatorCredits));
    }
    function validGameItemTradeWallet(data, profileId) {
      let receiptPath = /databases/$(database)/documents/gameItemTransactions/$(data.lastEventId);
      return isCallerProfile(profileId)
        && data.lastEventType == 'game_item_trade'
        && data.lastEventId.size() > 0
        && !exists(receiptPath) && existsAfter(receiptPath)
        && getAfter(receiptPath).data.profileId == profileId
        && data.totalEarned == resource.data.totalEarned
        && data.totalLost == resource.data.totalLost
        && ((getAfter(receiptPath).data.direction == 'buy'
            && data.balance == resource.data.balance - getAfter(receiptPath).data.credits)
          || (getAfter(receiptPath).data.direction == 'sell'
            && data.balance == resource.data.balance + getAfter(receiptPath).data.credits));
    }
    function validNewTransferRecipientWallet(data, profileId) {
      let transferPath = /databases/$(database)/documents/creditTransfers/$(data.lastEventId);
      return data.lastEventType == 'player_transfer_in'
        && data.lastEventId.size() > 0
        && !exists(transferPath) && existsAfter(transferPath)
        && getAfter(transferPath).data.fromProfileId == callerProfileId()
        && getAfter(transferPath).data.toProfileId == profileId
        && data.balance == getAfter(transferPath).data.amount
        && data.totalEarned == 0 && data.totalLost == 0;
    }
    match /creditWallets/{profileId} {
      // Credit balances are game-economy data. Authenticated LCS identities may
      // read wallets so transfers can atomically choose recipient create vs update.
      // Mutations remain receipt-validated below.
      allow read: if hasPrivateAccount();
      allow create: if validCreditWallet(request.resource.data, profileId)
        && ((isCallerProfile(profileId)
            && request.resource.data.balance == 0
            && request.resource.data.totalEarned == 0
            && request.resource.data.totalLost == 0
            && request.resource.data.lastEventId == ''
            && request.resource.data.lastEventType == 'init')
          || validNewTransferRecipientWallet(request.resource.data, profileId));
      allow update: if validCreditWallet(request.resource.data, profileId)
        && request.resource.data.profileId == resource.data.profileId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt is timestamp
        && ((isCallerProfile(profileId)
              && (validSlimeKillCredit(request.resource.data) || validDeathCreditLoss(request.resource.data) || validGameItemTradeWallet(request.resource.data, profileId)))
          || validDirectCreditTransferWallet(request.resource.data, profileId)
          || validPlayerTradeWallet(request.resource.data, profileId));
      allow delete: if false;
    }

    // ============================================================
    // E.R.A.S. GAME INVENTORY + NORTH TERMINAL
    // Separate from assetHoldings/assetInventory. Items in this namespace are
    // ephemeral gameplay possessions and are designed to clear on death.
    // ============================================================
    function validGameInventoryEventType(value) { return value in ['init','slime_drop','terminal_buy','terminal_sell','consume_potion','equip','death']; }
    function validGameEquippedWeapon(value) { return value in ['','hand_wraps','stick']; }
    function validGameInventory(data, profileId) {
      return data.keys().hasOnly(['profileId','slimeJuice','healthPotion','handWraps','stick','equippedWeapon','lastEventId','lastEventType','lastDeathEventId','createdAt','updatedAt'])
        && data.profileId == profileId
        && data.slimeJuice is int && data.slimeJuice >= 0
        && data.healthPotion is int && data.healthPotion >= 0
        && data.handWraps is int && data.handWraps >= 0
        && data.stick is int && data.stick >= 0
        && validGameEquippedWeapon(data.equippedWeapon)
        && data.lastEventId is string && data.lastEventId.size() <= 180
        && validGameInventoryEventType(data.lastEventType)
        && data.lastDeathEventId is string && data.lastDeathEventId.size() <= 180
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }
    function validSlimeDropInventory(data) {
      let actionPath = /databases/$(database)/documents/gameActions/$(data.lastEventId);
      return isCallerProfile(data.profileId)
        && data.lastEventType == 'slime_drop'
        && data.lastEventId.size() > 0
        && data.lastEventId != resource.data.lastEventId
        && data.slimeJuice >= resource.data.slimeJuice && data.slimeJuice <= resource.data.slimeJuice + 1
        && data.healthPotion >= resource.data.healthPotion && data.healthPotion <= resource.data.healthPotion + 1
        && data.handWraps >= resource.data.handWraps && data.handWraps <= resource.data.handWraps + 1
        && data.slimeJuice + data.healthPotion + data.handWraps > resource.data.slimeJuice + resource.data.healthPotion + resource.data.handWraps
        && data.stick == resource.data.stick
        && data.equippedWeapon == resource.data.equippedWeapon
        && data.lastDeathEventId == resource.data.lastDeathEventId
        && existsAfter(actionPath)
        && getAfter(actionPath).data.actorProfileId == callerProfileId()
        && getAfter(actionPath).data.actionType == 'attack'
        && getAfter(actionPath).data.targetType == 'enemy'
        && getAfter(actionPath).data.status == 'resolved'
        && getAfter(actionPath).data.outcome == 'kill';
    }
    function validGameItemReceipt(data) {
      return data.keys().hasOnly(['profileId','direction','itemId','quantity','credits','createdAt'])
        && validPublicId(data.profileId) && profileExists(data.profileId)
        && data.direction in ['buy','sell']
        && data.itemId in ['health_potion','slime_juice','stick']
        && data.quantity == 1
        && data.credits is int && data.credits >= 1
        && data.createdAt is timestamp
        && ((data.direction == 'buy' && data.itemId == 'health_potion' && data.credits == 3)
          || (data.direction == 'buy' && data.itemId == 'stick' && data.credits == 5)
          || (data.direction == 'sell' && data.itemId == 'slime_juice' && data.credits == 1));
    }
    function validTerminalInventoryTransition(data) {
      let receiptPath = /databases/$(database)/documents/gameItemTransactions/$(data.lastEventId);
      let walletPath = /databases/$(database)/documents/creditWallets/$(data.profileId);
      return isCallerProfile(data.profileId)
        && data.lastEventId.size() > 0
        && !exists(receiptPath) && existsAfter(receiptPath)
        && getAfter(receiptPath).data.profileId == data.profileId
        && existsAfter(walletPath)
        && getAfter(walletPath).data.lastEventId == data.lastEventId
        && getAfter(walletPath).data.lastEventType == 'game_item_trade'
        && data.equippedWeapon == resource.data.equippedWeapon
        && data.lastDeathEventId == resource.data.lastDeathEventId
        && ((data.lastEventType == 'terminal_buy'
            && getAfter(receiptPath).data.direction == 'buy'
            && ((getAfter(receiptPath).data.itemId == 'health_potion'
                && data.healthPotion == resource.data.healthPotion + 1
                && data.slimeJuice == resource.data.slimeJuice && data.handWraps == resource.data.handWraps && data.stick == resource.data.stick)
              || (getAfter(receiptPath).data.itemId == 'stick'
                && data.stick == resource.data.stick + 1
                && data.slimeJuice == resource.data.slimeJuice && data.healthPotion == resource.data.healthPotion && data.handWraps == resource.data.handWraps)))
          || (data.lastEventType == 'terminal_sell'
            && getAfter(receiptPath).data.direction == 'sell'
            && getAfter(receiptPath).data.itemId == 'slime_juice'
            && data.slimeJuice == resource.data.slimeJuice - 1
            && data.healthPotion == resource.data.healthPotion && data.handWraps == resource.data.handWraps && data.stick == resource.data.stick));
    }
    function validConsumePotionInventory(data) {
      return isCallerProfile(data.profileId)
        && data.lastEventType == 'consume_potion'
        && data.lastEventId.size() > 0
        && data.healthPotion == resource.data.healthPotion - 1
        && data.slimeJuice == resource.data.slimeJuice
        && data.handWraps == resource.data.handWraps
        && data.stick == resource.data.stick
        && data.equippedWeapon == resource.data.equippedWeapon
        && data.lastDeathEventId == resource.data.lastDeathEventId;
    }
    function validEquipInventory(data) {
      return isCallerProfile(data.profileId)
        && data.lastEventType == 'equip'
        && data.lastEventId.size() > 0
        && data.slimeJuice == resource.data.slimeJuice
        && data.healthPotion == resource.data.healthPotion
        && data.lastDeathEventId == resource.data.lastDeathEventId
        && data.handWraps + (data.equippedWeapon == 'hand_wraps' ? 1 : 0) == resource.data.handWraps + (resource.data.equippedWeapon == 'hand_wraps' ? 1 : 0)
        && data.stick + (data.equippedWeapon == 'stick' ? 1 : 0) == resource.data.stick + (resource.data.equippedWeapon == 'stick' ? 1 : 0);
    }
    function validDeathInventoryClear(data) {
      return isCallerProfile(data.profileId)
        && data.lastEventType == 'death'
        && data.lastEventId.size() > 0
        && data.lastDeathEventId == data.lastEventId
        && data.slimeJuice == 0 && data.healthPotion == 0 && data.handWraps == 0 && data.stick == 0
        && data.equippedWeapon == '';
    }
    match /gameInventories/{profileId} {
      allow read: if hasPrivateAccount() && isCallerProfile(profileId);
      allow create: if callerCanContribute()
        && isCallerProfile(profileId)
        && validGameInventory(request.resource.data, profileId)
        && request.resource.data.slimeJuice == 0 && request.resource.data.healthPotion == 0
        && request.resource.data.handWraps == 0 && request.resource.data.stick == 0
        && request.resource.data.equippedWeapon == ''
        && request.resource.data.lastEventId == '' && request.resource.data.lastEventType == 'init'
        && request.resource.data.lastDeathEventId == '';
      allow update: if callerCanContribute()
        && request.resource.data.profileId == resource.data.profileId
        && request.resource.data.createdAt == resource.data.createdAt
        && validGameInventory(request.resource.data, profileId)
        && (validSlimeDropInventory(request.resource.data)
          || validTerminalInventoryTransition(request.resource.data)
          || validConsumePotionInventory(request.resource.data)
          || validEquipInventory(request.resource.data)
          || validDeathInventoryClear(request.resource.data));
      allow delete: if false;
    }
    function validGameItemTransactionSettlement(transactionId, data) {
      let walletPath = /databases/$(database)/documents/creditWallets/$(data.profileId);
      let inventoryPath = /databases/$(database)/documents/gameInventories/$(data.profileId);
      return exists(walletPath) && exists(inventoryPath)
        && existsAfter(walletPath) && existsAfter(inventoryPath)
        && getAfter(walletPath).data.lastEventId == transactionId
        && getAfter(walletPath).data.lastEventType == 'game_item_trade'
        && getAfter(inventoryPath).data.lastEventId == transactionId
        && ((data.direction == 'buy'
            && get(walletPath).data.balance >= data.credits
            && getAfter(walletPath).data.balance == get(walletPath).data.balance - data.credits
            && ((data.itemId == 'health_potion' && getAfter(inventoryPath).data.healthPotion == get(inventoryPath).data.healthPotion + 1)
              || (data.itemId == 'stick' && getAfter(inventoryPath).data.stick == get(inventoryPath).data.stick + 1)))
          || (data.direction == 'sell'
            && data.itemId == 'slime_juice'
            && get(inventoryPath).data.slimeJuice >= 1
            && getAfter(walletPath).data.balance == get(walletPath).data.balance + data.credits
            && getAfter(inventoryPath).data.slimeJuice == get(inventoryPath).data.slimeJuice - 1));
    }
    match /gameItemTransactions/{transactionId} {
      allow read: if hasPrivateAccount() && isCallerProfile(resource.data.profileId);
      allow create: if callerCanContribute()
        && isCallerProfile(request.resource.data.profileId)
        && validGameItemReceipt(request.resource.data)
        && validGameItemTransactionSettlement(transactionId, request.resource.data);
      allow update, delete: if false;
    }

    // ============================================================
    // PLAYER CREDIT TRANSFERS
    // Immutable anti-replay receipts. The receipt and both wallet mutations
    // must be created in the same atomic batch.
    // ============================================================
    function validCreditTransfer(data) {
      return data.keys().hasOnly(['fromProfileId','toProfileId','amount','note','createdAt'])
        && validPublicId(data.fromProfileId) && profileExists(data.fromProfileId)
        && validPublicId(data.toProfileId) && profileExists(data.toProfileId)
        && data.fromProfileId != data.toProfileId
        && data.amount is int && data.amount >= 1 && data.amount <= 1000000
        && data.note is string && data.note.size() <= 120
        && data.createdAt is timestamp;
    }
    function validCreditTransferSettlement(transferId, data) {
      let fromPath = /databases/$(database)/documents/creditWallets/$(data.fromProfileId);
      let toPath = /databases/$(database)/documents/creditWallets/$(data.toProfileId);
      return exists(fromPath)
        && existsAfter(fromPath) && existsAfter(toPath)
        && get(fromPath).data.balance >= data.amount
        && getAfter(fromPath).data.balance == get(fromPath).data.balance - data.amount
        && ((exists(toPath) && getAfter(toPath).data.balance == get(toPath).data.balance + data.amount)
          || (!exists(toPath)
            && getAfter(toPath).data.balance == data.amount
            && getAfter(toPath).data.totalEarned == 0
            && getAfter(toPath).data.totalLost == 0))
        && getAfter(fromPath).data.lastEventId == transferId
        && getAfter(fromPath).data.lastEventType == 'player_transfer_out'
        && getAfter(toPath).data.lastEventId == transferId
        && getAfter(toPath).data.lastEventType == 'player_transfer_in';
    }
    match /creditTransfers/{transferId} {
      allow read: if hasPrivateAccount()
        && (resource.data.fromProfileId == callerProfileId() || resource.data.toProfileId == callerProfileId());
      allow create: if hasPrivateAccount()
        && request.resource.data.fromProfileId == callerProfileId()
        && validCreditTransfer(request.resource.data)
        && validCreditTransferSettlement(transferId, request.resource.data);
      allow update, delete: if false;
    }

    // ============================================================
    // E.R.A.S. GLOBAL SCOREBOARD
    // PvE/PvP kill counters describe the player's current life/run. A Global
    // death resets both counters atomically with the authoritative presence
    // death transition. The rolling PvP record still comes from gameActions.
    // ============================================================
    function validGlobalStats(data, profileId) {
      let resetEventId = data.get('lastResetDeathEventId','');
      return data.keys().hasOnly(['profileId','pveKills','pvpKills','lastPveKillActionId','lastPvpKillActionId','lastResetDeathEventId','createdAt','updatedAt'])
        && data.profileId == profileId
        && validPublicId(data.profileId) && profileExists(data.profileId)
        && data.pveKills is int && data.pveKills >= 0
        && data.pvpKills is int && data.pvpKills >= 0
        && data.lastPveKillActionId is string && data.lastPveKillActionId.size() <= 180
        && data.lastPvpKillActionId is string && data.lastPvpKillActionId.size() <= 180
        && resetEventId is string && resetEventId.size() <= 180
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }
    function validScoreKillAction(actionId, targetType) {
      let actionPath = /databases/$(database)/documents/gameActions/$(actionId);
      return actionId.size() > 0
        && existsAfter(actionPath)
        && getAfter(actionPath).data.worldId == 'global'
        && getAfter(actionPath).data.actorProfileId == callerProfileId()
        && getAfter(actionPath).data.actionType == 'attack'
        && getAfter(actionPath).data.targetType == targetType
        && getAfter(actionPath).data.status == 'resolved'
        && getAfter(actionPath).data.outcome == 'kill';
    }
    function validPveScoreIncrement(data) {
      return data.pveKills == resource.data.pveKills + 1
        && data.pvpKills == resource.data.pvpKills
        && data.lastPveKillActionId != resource.data.lastPveKillActionId
        && data.lastPvpKillActionId == resource.data.lastPvpKillActionId
        && data.get('lastResetDeathEventId','') == resource.data.get('lastResetDeathEventId','')
        && validScoreKillAction(data.lastPveKillActionId, 'enemy');
    }
    function validPvpScoreIncrement(data) {
      return data.pveKills == resource.data.pveKills
        && data.pvpKills == resource.data.pvpKills + 1
        && data.lastPveKillActionId == resource.data.lastPveKillActionId
        && data.lastPvpKillActionId != resource.data.lastPvpKillActionId
        && data.get('lastResetDeathEventId','') == resource.data.get('lastResetDeathEventId','')
        && validScoreKillAction(data.lastPvpKillActionId, 'profile');
    }
    function validScoreDeathReset(data, profileId) {
      let presenceId = profileId + '__global';
      let presencePath = /databases/$(database)/documents/gamePresence/$(presenceId);
      let deathEventId = data.get('lastResetDeathEventId','');
      return deathEventId.size() > 0
        && data.pveKills == 0
        && data.pvpKills == 0
        && data.lastPveKillActionId == resource.data.lastPveKillActionId
        && data.lastPvpKillActionId == resource.data.lastPvpKillActionId
        && deathEventId != resource.data.get('lastResetDeathEventId','')
        && exists(presencePath)
        && existsAfter(presencePath)
        && getAfter(presencePath).data.profileId == profileId
        && getAfter(presencePath).data.worldId == 'global'
        && getAfter(presencePath).data.deaths == get(presencePath).data.deaths + 1
        && getAfter(presencePath).data.lastDeathEventId == deathEventId
        && getAfter(presencePath).data.lastDeathEventId != get(presencePath).data.lastDeathEventId;
    }
    match /globalGameStats/{profileId} {
      allow read: if signedIn();
      allow create: if isCallerProfile(profileId)
        && validGlobalStats(request.resource.data, profileId)
        && request.resource.data.pveKills == 0
        && request.resource.data.pvpKills == 0
        && request.resource.data.lastPveKillActionId == ''
        && request.resource.data.lastPvpKillActionId == ''
        && request.resource.data.get('lastResetDeathEventId','') == '';
      allow update: if signedIn()
        && validGlobalStats(request.resource.data, profileId)
        && request.resource.data.profileId == resource.data.profileId
        && request.resource.data.createdAt == resource.data.createdAt
        && ((isCallerProfile(profileId)
            && (validPveScoreIncrement(request.resource.data) || validPvpScoreIncrement(request.resource.data)))
          || validScoreDeathReset(request.resource.data, profileId));
      allow delete: if false;
    }

    // ============================================================
    // E.R.A.S. ASSET INVENTORY
    // Public asset files live under /public-assets/ on GitHub Pages.
    // Firestore stores only per-profile ownership/configuration.
    // ============================================================
    function validErasAssetId(id) {
      return id in ['eras:slime_monochrome'];
    }
    function validAssetTint(tint) {
      return tint is string && tint.matches('#[0-9a-fA-F]{6}');
    }
    match /assetInventory/{profileId}/items/{inventoryId} {
      allow read: if isCallerProfile(profileId);
      allow create: if isCallerProfile(profileId)
        && request.resource.data.keys().hasOnly(['assetId','profileId','tint','acquiredAt','updatedAt'])
        && request.resource.data.profileId == profileId
        && validErasAssetId(request.resource.data.assetId)
        && validAssetTint(request.resource.data.tint)
        && request.resource.data.acquiredAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow update: if isCallerProfile(profileId)
        && request.resource.data.keys().hasOnly(['assetId','profileId','tint','acquiredAt','updatedAt'])
        && request.resource.data.profileId == resource.data.profileId
        && request.resource.data.profileId == profileId
        && request.resource.data.assetId == resource.data.assetId
        && request.resource.data.acquiredAt == resource.data.acquiredAt
        && validErasAssetId(request.resource.data.assetId)
        && validAssetTint(request.resource.data.tint)
        && request.resource.data.updatedAt is timestamp;
      allow delete: if isCallerProfile(profileId);
    }

    // ============================================================
    // UNIVERSAL ASSET HOLDINGS
    // Tradable ownership lives in a root collection so an atomic trade can
    // change owner without copying/deleting per-user inventory documents.
    // ============================================================
    function validAssetHoldingEventType(value) { return value in ['market_acquire','migration','trade']; }
    function validAssetHolding(data) {
      return data.keys().hasOnly(['ownerProfileId','assetId','tint','acquiredAt','updatedAt','lastEventId','lastEventType'])
        && validPublicId(data.ownerProfileId) && profileExists(data.ownerProfileId)
        && validErasAssetId(data.assetId)
        && validAssetTint(data.tint)
        && data.acquiredAt is timestamp && data.updatedAt is timestamp
        && data.lastEventId is string && data.lastEventId.size() <= 180
        && validAssetHoldingEventType(data.lastEventType);
    }
    function validHoldingTradeUpdate(holdingId, data) {
      let settlementPath = /databases/$(database)/documents/tradeSettlements/$(data.lastEventId);
      return data.lastEventType == 'trade'
        && !exists(settlementPath) && existsAfter(settlementPath)
        && getAfter(settlementPath).data.initiatorProfileId == callerProfileId()
        && data.assetId == resource.data.assetId
        && data.tint == resource.data.tint
        && data.acquiredAt == resource.data.acquiredAt
        && ((holdingId == getAfter(settlementPath).data.initiatorHoldingId
            && resource.data.ownerProfileId == getAfter(settlementPath).data.initiatorProfileId
            && data.ownerProfileId == getAfter(settlementPath).data.recipientProfileId
            && data.assetId == getAfter(settlementPath).data.initiatorAssetId
            && data.tint == getAfter(settlementPath).data.initiatorAssetTint)
          || (holdingId == getAfter(settlementPath).data.recipientHoldingId
            && resource.data.ownerProfileId == getAfter(settlementPath).data.recipientProfileId
            && data.ownerProfileId == getAfter(settlementPath).data.initiatorProfileId
            && data.assetId == getAfter(settlementPath).data.recipientAssetId
            && data.tint == getAfter(settlementPath).data.recipientAssetTint));
    }
    match /assetHoldings/{holdingId} {
      allow read: if hasPrivateAccount() && resource.data.ownerProfileId == callerProfileId();
      allow create: if callerCanContribute()
        && request.resource.data.ownerProfileId == callerProfileId()
        && validAssetHolding(request.resource.data)
        && ((request.resource.data.lastEventType == 'market_acquire' && request.resource.data.lastEventId == '')
          || (request.resource.data.lastEventType == 'migration' && request.resource.data.lastEventId == 'legacy-migration'));
      allow update: if validAssetHolding(request.resource.data)
        && request.resource.data.updatedAt is timestamp
        && ((resource.data.ownerProfileId == callerProfileId()
            && request.resource.data.ownerProfileId == resource.data.ownerProfileId
            && request.resource.data.assetId == resource.data.assetId
            && request.resource.data.acquiredAt == resource.data.acquiredAt
            && request.resource.data.lastEventId == resource.data.lastEventId
            && request.resource.data.lastEventType == resource.data.lastEventType)
          || validHoldingTradeUpdate(holdingId, request.resource.data));
      allow delete: if false;
    }

    // ============================================================
    // PLAYER TRADES
    // Initiator fixes side A, recipient explicitly locks side B, then only the
    // initiator can atomically finalize. Wallets + holdings settle together.
    // ============================================================
    function validPlayerTradeStatus(value) { return value in ['pending','locked','completed','declined','cancelled']; }
    function validTradeAssetTuple(holdingId, assetId, tint) {
      return (holdingId == '' && assetId == '' && tint == '')
        || (holdingId is string && holdingId.size() >= 8 && holdingId.size() <= 180
          && validErasAssetId(assetId) && validAssetTint(tint));
    }
    function validPlayerTrade(data) {
      return data.keys().hasOnly(['initiatorProfileId','recipientProfileId','initiatorCredits','recipientCredits','initiatorHoldingId','initiatorAssetId','initiatorAssetTint','recipientHoldingId','recipientAssetId','recipientAssetTint','status','createdAt','updatedAt','completedAt'])
        && validPublicId(data.initiatorProfileId) && profileExists(data.initiatorProfileId)
        && validPublicId(data.recipientProfileId) && profileExists(data.recipientProfileId)
        && data.initiatorProfileId != data.recipientProfileId
        && data.initiatorCredits is int && data.initiatorCredits >= 0 && data.initiatorCredits <= 1000000
        && data.recipientCredits is int && data.recipientCredits >= 0 && data.recipientCredits <= 1000000
        && validTradeAssetTuple(data.initiatorHoldingId,data.initiatorAssetId,data.initiatorAssetTint)
        && validTradeAssetTuple(data.recipientHoldingId,data.recipientAssetId,data.recipientAssetTint)
        && (data.initiatorHoldingId == '' || data.initiatorHoldingId != data.recipientHoldingId)
        && validPlayerTradeStatus(data.status)
        && data.createdAt is timestamp && data.updatedAt is timestamp
        && validOptionalTimestamp(data.completedAt);
    }
    function tradeHoldingOwnedAndMatches(profileId, holdingId, assetId, tint) {
      let safeHoldingId = holdingId == '' ? '__none__' : holdingId;
      let holdingPath = /databases/$(database)/documents/assetHoldings/$(safeHoldingId);
      return holdingId == ''
        || (exists(holdingPath)
          && get(holdingPath).data.ownerProfileId == profileId
          && get(holdingPath).data.assetId == assetId
          && get(holdingPath).data.tint == tint);
    }
    function playerTradeFixedTerms(before, after) {
      return after.initiatorProfileId == before.initiatorProfileId
        && after.recipientProfileId == before.recipientProfileId
        && after.initiatorCredits == before.initiatorCredits
        && after.initiatorHoldingId == before.initiatorHoldingId
        && after.initiatorAssetId == before.initiatorAssetId
        && after.initiatorAssetTint == before.initiatorAssetTint
        && after.createdAt == before.createdAt;
    }
    function playerTradeAllTermsFixed(before, after) {
      return playerTradeFixedTerms(before,after)
        && after.recipientCredits == before.recipientCredits
        && after.recipientHoldingId == before.recipientHoldingId
        && after.recipientAssetId == before.recipientAssetId
        && after.recipientAssetTint == before.recipientAssetTint;
    }
    function tradeSettlementHoldingValid(holdingId, ownerBefore, ownerAfter, assetId, tint, tradeId) {
      let safeId = holdingId == '' ? '__none_settlement__' : holdingId;
      let path = /databases/$(database)/documents/assetHoldings/$(safeId);
      return holdingId == '' || (exists(path) && existsAfter(path)
        && get(path).data.ownerProfileId == ownerBefore
        && get(path).data.assetId == assetId && get(path).data.tint == tint
        && getAfter(path).data.ownerProfileId == ownerAfter
        && getAfter(path).data.assetId == assetId && getAfter(path).data.tint == tint
        && getAfter(path).data.lastEventId == tradeId && getAfter(path).data.lastEventType == 'trade');
    }
    function validTradeSettlementReceipt(tradeId, data) {
      let tradePath = /databases/$(database)/documents/playerTrades/$(tradeId);
      let iWallet = /databases/$(database)/documents/creditWallets/$(data.initiatorProfileId);
      let rWallet = /databases/$(database)/documents/creditWallets/$(data.recipientProfileId);
      return data.keys().hasOnly(['initiatorProfileId','recipientProfileId','initiatorCredits','recipientCredits','initiatorHoldingId','initiatorAssetId','initiatorAssetTint','recipientHoldingId','recipientAssetId','recipientAssetTint','createdAt'])
        && data.createdAt is timestamp
        && existsAfter(tradePath)
        && getAfter(tradePath).data.status == 'completed'
        && getAfter(tradePath).data.initiatorProfileId == callerProfileId()
        && data.initiatorProfileId == getAfter(tradePath).data.initiatorProfileId
        && data.recipientProfileId == getAfter(tradePath).data.recipientProfileId
        && data.initiatorCredits == getAfter(tradePath).data.initiatorCredits
        && data.recipientCredits == getAfter(tradePath).data.recipientCredits
        && data.initiatorHoldingId == getAfter(tradePath).data.initiatorHoldingId
        && data.initiatorAssetId == getAfter(tradePath).data.initiatorAssetId
        && data.initiatorAssetTint == getAfter(tradePath).data.initiatorAssetTint
        && data.recipientHoldingId == getAfter(tradePath).data.recipientHoldingId
        && data.recipientAssetId == getAfter(tradePath).data.recipientAssetId
        && data.recipientAssetTint == getAfter(tradePath).data.recipientAssetTint
        && exists(iWallet) && exists(rWallet) && existsAfter(iWallet) && existsAfter(rWallet)
        && get(iWallet).data.balance >= data.initiatorCredits
        && get(rWallet).data.balance >= data.recipientCredits
        && getAfter(iWallet).data.balance == get(iWallet).data.balance - data.initiatorCredits + data.recipientCredits
        && getAfter(rWallet).data.balance == get(rWallet).data.balance - data.recipientCredits + data.initiatorCredits
        && getAfter(iWallet).data.lastEventId == tradeId && getAfter(iWallet).data.lastEventType == 'trade'
        && getAfter(rWallet).data.lastEventId == tradeId && getAfter(rWallet).data.lastEventType == 'trade'
        && tradeSettlementHoldingValid(data.initiatorHoldingId,data.initiatorProfileId,data.recipientProfileId,data.initiatorAssetId,data.initiatorAssetTint,tradeId)
        && tradeSettlementHoldingValid(data.recipientHoldingId,data.recipientProfileId,data.initiatorProfileId,data.recipientAssetId,data.recipientAssetTint,tradeId);
    }
    match /tradeSettlements/{tradeId} {
      allow read: if hasPrivateAccount()
        && (resource.data.initiatorProfileId == callerProfileId() || resource.data.recipientProfileId == callerProfileId());
      allow create: if hasPrivateAccount()
        && request.resource.data.initiatorProfileId == callerProfileId()
        && !exists(/databases/$(database)/documents/tradeSettlements/$(tradeId))
        && validTradeSettlementReceipt(tradeId,request.resource.data);
      allow update, delete: if false;
    }

    function walletHasCreditsOrZero(profileId, amount) {
      let walletPath = /databases/$(database)/documents/creditWallets/$(profileId);
      return amount == 0 || (exists(walletPath)
        && get(walletPath).data.balance is int
        && get(walletPath).data.balance >= amount);
    }

    match /playerTrades/{tradeId} {
      allow read: if hasPrivateAccount()
        && (resource.data.initiatorProfileId == callerProfileId() || resource.data.recipientProfileId == callerProfileId());
      allow create: if hasPrivateAccount()
        && request.resource.data.initiatorProfileId == callerProfileId()
        && request.resource.data.status == 'pending'
        && request.resource.data.recipientCredits == 0
        && request.resource.data.recipientHoldingId == ''
        && request.resource.data.recipientAssetId == ''
        && request.resource.data.recipientAssetTint == ''
        && request.resource.data.completedAt == null
        && validPlayerTrade(request.resource.data)
        && walletHasCreditsOrZero(callerProfileId(), request.resource.data.initiatorCredits)
        && tradeHoldingOwnedAndMatches(request.resource.data.initiatorProfileId,request.resource.data.initiatorHoldingId,request.resource.data.initiatorAssetId,request.resource.data.initiatorAssetTint);
      allow update: if hasPrivateAccount()
        && validPlayerTrade(request.resource.data)
        && request.resource.data.updatedAt is timestamp
        && (
          (callerProfileId() == resource.data.recipientProfileId
            && resource.data.status == 'pending' && request.resource.data.status == 'locked'
            && playerTradeFixedTerms(resource.data,request.resource.data)
            && request.resource.data.completedAt == null
            && (request.resource.data.initiatorCredits > 0 || request.resource.data.recipientCredits > 0 || request.resource.data.initiatorHoldingId != '' || request.resource.data.recipientHoldingId != '')
            && walletHasCreditsOrZero(callerProfileId(), request.resource.data.recipientCredits)
            && tradeHoldingOwnedAndMatches(request.resource.data.recipientProfileId,request.resource.data.recipientHoldingId,request.resource.data.recipientAssetId,request.resource.data.recipientAssetTint))
          || (callerProfileId() == resource.data.initiatorProfileId
            && resource.data.status in ['pending','locked'] && request.resource.data.status == 'cancelled'
            && playerTradeAllTermsFixed(resource.data,request.resource.data)
            && request.resource.data.completedAt == null)
          || (callerProfileId() == resource.data.recipientProfileId
            && resource.data.status in ['pending','locked'] && request.resource.data.status == 'declined'
            && playerTradeAllTermsFixed(resource.data,request.resource.data)
            && request.resource.data.completedAt == null)
          || (callerProfileId() == resource.data.initiatorProfileId
            && resource.data.status == 'locked' && request.resource.data.status == 'completed'
            && playerTradeAllTermsFixed(resource.data,request.resource.data)
            && request.resource.data.completedAt is timestamp
            && !exists(/databases/$(database)/documents/tradeSettlements/$(tradeId))
            && existsAfter(/databases/$(database)/documents/tradeSettlements/$(tradeId)))
        );
      allow delete: if false;
    }

    // ============================================================
    // E.R.A.S. HOST / JOIN LOBBIES
    // Lobby documents are discovery/orchestration data. They contain
    // no private Google identity information.
    // ============================================================
    function validLobbyVisibility(value) { return value in ['public','friends','code']; }
    function validLobbyStatus(value) { return value in ['open','playing','closed']; }
    function validGameLobby(data) {
      return data.keys().hasOnly(['name','code','hostProfileId','visibility','maxPlayers','mapId','gameStyle','description','status','createdAt','updatedAt','lastHeartbeatAt'])
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 50
        && data.code is string && data.code.matches('[A-Z2-9]{6}')
        && validPublicId(data.hostProfileId) && profileExists(data.hostProfileId)
        && validLobbyVisibility(data.visibility)
        && data.maxPlayers is int && data.maxPlayers >= 2 && data.maxPlayers <= 32
        && data.mapId in ['global-plaza','slime-yard']
        && data.gameStyle == 'arcade-topdown'
        && data.description is string && data.description.size() <= 240
        && validLobbyStatus(data.status)
        && data.createdAt is timestamp && data.updatedAt is timestamp && data.lastHeartbeatAt is timestamp;
    }
    match /gameLobbies/{lobbyId} {
      allow read: if signedIn();
      allow create: if callerCanContribute()
        && isCallerProfile(request.resource.data.hostProfileId)
        && request.resource.data.status == 'open'
        && validGameLobby(request.resource.data);
      allow update: if callerCanContribute()
        && isCallerProfile(resource.data.hostProfileId)
        && request.resource.data.hostProfileId == resource.data.hostProfileId
        && request.resource.data.createdAt == resource.data.createdAt
        && validGameLobby(request.resource.data);
      allow delete: if isCallerProfile(resource.data.hostProfileId);

      match /members/{profileId} {
        function parentLobby() {
          return get(/databases/$(database)/documents/gameLobbies/$(lobbyId));
        }
        function validLobbyMember(data) {
          return data.keys().hasOnly(['profileId','role','joinedAt','lastSeenAt'])
            && data.profileId == profileId
            && validPublicId(data.profileId) && profileExists(data.profileId)
            && data.role in ['host','player']
            && data.role == (parentLobby().data.hostProfileId == profileId ? 'host' : 'player')
            && data.joinedAt is timestamp && data.lastSeenAt is timestamp;
        }
        allow read: if signedIn();
        allow create, update: if callerCanContribute()
          && isCallerProfile(profileId)
          && parentLobby().data.status == 'open'
          && validLobbyMember(request.resource.data);
        allow delete: if isCallerProfile(profileId)
          || (hasPrivateAccount() && parentLobby().data.hostProfileId == callerProfileId());
      }
    }

    // ============================================================
    // E.R.A.S. GLOBAL / LOBBY PRESENCE
    // Low-frequency movement state plus combat/rest state. PvP attackers may
    // only alter a target presence when the same atomic write resolves their
    // queued profile attack.
    // ============================================================
    function validWorldId(value) {
      return value is string && value.size() > 0 && value.size() <= 160;
    }
    function playerAtNorthPlatformSpawn(data) {
      return data.x >= 11 && data.x <= 32 && data.y >= 11 && data.y <= 28;
    }
    function validPresence(data) {
      return data.keys().hasOnly(['worldId','profileId','x','y','vx','vy','turnNumber','moveUsed','hp','maxHp','deaths','lastDeathEventId','lastCombatTurn','restedTurn','movedTurn','actionTurn','lastPvpEventId','updatedAt'])
        && validWorldId(data.worldId)
        && validPublicId(data.profileId) && profileExists(data.profileId)
        && data.x is number && data.x >= 0 && data.x <= 100
        && data.y is number && data.y >= 0 && data.y <= 100
        && data.vx is number && data.vx >= -50 && data.vx <= 50
        && data.vy is number && data.vy >= -50 && data.vy <= 50
        && data.turnNumber is int && data.turnNumber >= 1
        && data.moveUsed is number && data.moveUsed >= 0 && data.moveUsed <= 40.25
        && data.hp is int && data.hp >= 0 && data.hp <= 3
        && data.maxHp == 3
        && data.deaths is int && data.deaths >= 0
        && data.lastDeathEventId is string && data.lastDeathEventId.size() <= 180
        && data.lastCombatTurn is int && data.lastCombatTurn >= 0
        && data.restedTurn is int && data.restedTurn >= 0
        && data.movedTurn is int && data.movedTurn >= 0
        && data.actionTurn is int && data.actionTurn >= 0
        && data.lastPvpEventId is string && data.lastPvpEventId.size() <= 180
        && data.updatedAt is timestamp;
    }
    function validOwnRestTransition() {
      return request.resource.data.restedTurn > resource.data.get('restedTurn',0)
        && request.resource.data.restedTurn == request.resource.data.turnNumber
        && resource.data.moveUsed <= 0.001
        && resource.data.get('movedTurn',0) != request.resource.data.restedTurn
        && resource.data.get('actionTurn',0) != request.resource.data.restedTurn
        && request.resource.data.hp == 3
        && request.resource.data.deaths == resource.data.deaths
        && request.resource.data.x == resource.data.x
        && request.resource.data.y == resource.data.y
        && request.resource.data.moveUsed == resource.data.moveUsed;
    }
    function validHealthPotionPresenceTransition() {
      let inventoryPath = /databases/$(database)/documents/gameInventories/$(resource.data.profileId);
      return isCallerProfile(resource.data.profileId)
        && exists(inventoryPath) && existsAfter(inventoryPath)
        && getAfter(inventoryPath).data.lastEventType == 'consume_potion'
        && getAfter(inventoryPath).data.lastEventId != get(inventoryPath).data.lastEventId
        && getAfter(inventoryPath).data.healthPotion == get(inventoryPath).data.healthPotion - 1
        && request.resource.data.hp > resource.data.hp
        && request.resource.data.hp <= resource.data.hp + 2
        && request.resource.data.hp <= 3
        && request.resource.data.worldId == resource.data.worldId
        && request.resource.data.profileId == resource.data.profileId
        && request.resource.data.maxHp == resource.data.maxHp
        && request.resource.data.x == resource.data.x && request.resource.data.y == resource.data.y
        && request.resource.data.vx == resource.data.vx && request.resource.data.vy == resource.data.vy
        && request.resource.data.turnNumber == resource.data.turnNumber
        && request.resource.data.moveUsed == resource.data.moveUsed
        && request.resource.data.deaths == resource.data.deaths
        && request.resource.data.lastDeathEventId == resource.data.lastDeathEventId
        && request.resource.data.lastCombatTurn == resource.data.lastCombatTurn
        && request.resource.data.restedTurn == resource.data.get('restedTurn',0)
        && request.resource.data.movedTurn == resource.data.get('movedTurn',0)
        && request.resource.data.actionTurn == resource.data.get('actionTurn',0)
        && request.resource.data.lastPvpEventId == resource.data.get('lastPvpEventId','');
    }
    function validOwnPresenceUpdate() {
      return isCallerProfile(resource.data.profileId)
        && request.resource.data.lastPvpEventId == resource.data.get('lastPvpEventId','')
        && (request.resource.data.hp <= resource.data.hp
          || request.resource.data.deaths > resource.data.deaths
          || validOwnRestTransition()
          || validHealthPotionPresenceTransition());
    }
    function validPvpPresenceTransition() {
      let actionId = request.resource.data.lastPvpEventId;
      let actionPath = /databases/$(database)/documents/gameActions/$(actionId);
      return callerCanContribute()
        && resource.data.profileId != callerProfileId()
        && actionId.size() > 0
        && existsAfter(actionPath)
        && getAfter(actionPath).data.worldId == resource.data.worldId
        && getAfter(actionPath).data.actorProfileId == callerProfileId()
        && getAfter(actionPath).data.actionType == 'attack'
        && getAfter(actionPath).data.targetType == 'profile'
        && getAfter(actionPath).data.targetId == resource.data.profileId
        && getAfter(actionPath).data.status == 'resolved'
        && getAfter(actionPath).data.outcome in ['hit','kill']
        && request.resource.data.worldId == resource.data.worldId
        && request.resource.data.profileId == resource.data.profileId
        && request.resource.data.maxHp == resource.data.maxHp
        && request.resource.data.turnNumber == resource.data.turnNumber
        && request.resource.data.restedTurn == resource.data.get('restedTurn',0)
        && request.resource.data.movedTurn == resource.data.get('movedTurn',0)
        && request.resource.data.actionTurn == resource.data.get('actionTurn',0)
        && request.resource.data.lastCombatTurn == resource.data.lastCombatTurn
        && request.resource.data.lastPvpEventId == actionId
        && ((getAfter(actionPath).data.outcome == 'hit'
          && resource.data.hp - request.resource.data.hp >= 1
          && resource.data.hp - request.resource.data.hp <= 2
          && (resource.data.hp - request.resource.data.hp == 1
            || (exists(/databases/$(database)/documents/gameInventories/$(callerProfileId()))
              && get(/databases/$(database)/documents/gameInventories/$(callerProfileId())).data.equippedWeapon == 'stick'))
          && request.resource.data.hp > 0
          && request.resource.data.deaths == resource.data.deaths
          && request.resource.data.lastDeathEventId == resource.data.lastDeathEventId
          && request.resource.data.x == resource.data.x
          && request.resource.data.y == resource.data.y
          && request.resource.data.vx == resource.data.vx
          && request.resource.data.vy == resource.data.vy
          && request.resource.data.moveUsed == resource.data.moveUsed)
        || (getAfter(actionPath).data.outcome == 'kill'
          && (resource.data.hp == 1
            || (resource.data.hp <= 2
              && exists(/databases/$(database)/documents/gameInventories/$(callerProfileId()))
              && get(/databases/$(database)/documents/gameInventories/$(callerProfileId())).data.equippedWeapon == 'stick'))
          && request.resource.data.hp == 3
          && request.resource.data.deaths == resource.data.deaths + 1
          && request.resource.data.lastDeathEventId == 'pvp_' + actionId
          && playerAtNorthPlatformSpawn(request.resource.data)
          && request.resource.data.vx == 0
          && request.resource.data.vy == 0
          && request.resource.data.moveUsed == 0));
    }
    match /gamePresence/{presenceId} {
      allow read: if signedIn();
      allow create: if callerCanContribute()
        && isCallerProfile(request.resource.data.profileId)
        && presenceId == request.resource.data.profileId + '__' + request.resource.data.worldId
        && validPresence(request.resource.data);
      allow update: if validPresence(request.resource.data)
        && presenceId == request.resource.data.profileId + '__' + request.resource.data.worldId
        && (validOwnPresenceUpdate() || validPvpPresenceTransition());
      allow delete: if isCallerProfile(resource.data.profileId);
    }

    // ============================================================
    // E.R.A.S. EPHEMERAL GLOBAL CLOCK PROBES
    // Each browser tab creates a uniquely keyed serverTimestamp probe, reads it
    // back from the server to calibrate the shared 60-second marker, then deletes
    // it immediately. This prevents desktop/mobile device-clock drift and avoids
    // relying on the shared presence document when the same account is open twice.
    // ============================================================
    function validClockProbe(data) {
      return data.keys().hasOnly(['profileId','clientId','worldId','requestedAt'])
        && validPublicId(data.profileId)
        && data.clientId is string && data.clientId.size() > 0 && data.clientId.size() <= 80
        && validWorldId(data.worldId)
        && data.requestedAt is timestamp;
    }
    match /gameClockProbes/{probeId} {
      allow read: if signedIn() && isCallerProfile(resource.data.profileId);
      allow create: if callerCanContribute()
        && isCallerProfile(request.resource.data.profileId)
        && validClockProbe(request.resource.data)
        && probeId == request.resource.data.profileId + '__' + request.resource.data.clientId;
      allow update: if false;
      allow delete: if signedIn() && isCallerProfile(resource.data.profileId);
    }

    // ============================================================
    // E.R.A.S. SHARED ENEMIES
    // Two one-HP Cache Slimes spawn randomly in the shared Cache/Yard zone and roam it while out of combat. A single
    // elected client advances their shared position at a low write frequency.
    // ============================================================
    function validEnemyKey(value) { return value in ['cache-slime-a','cache-slime-b']; }
    function validEnemyIdentity(data) {
      return (data.enemyKey == 'cache-slime-a' && data.label == 'CACHE SLIME A')
        || (data.enemyKey == 'cache-slime-b' && data.label == 'CACHE SLIME B');
    }
    function validEnemyBounds(data) {
      return data.x >= 76 && data.x <= 91 && data.y >= 68 && data.y <= 84;
    }
    function enemyAtSpawn(data) {
      // Initial spawns and marker respawns may land anywhere inside the shared
      // Slime Cache/Yard zone. Randomness is selected client-side; rules enforce
      // the authoritative geographic boundary.
      return validEnemyBounds(data);
    }
    function validGameEnemy(data) {
      return data.keys().hasOnly(['worldId','enemyKey','type','label','x','y','hp','maxHp','alive','respawnTurn','lastHitActionId','lastHitByProfileId','lastKillActionId','killerProfileId','wanderStep','lastWanderAt','updatedAt'])
        && validWorldId(data.worldId)
        && validEnemyKey(data.enemyKey)
        && validEnemyIdentity(data)
        && validEnemyBounds(data)
        && data.type == 'slime'
        && data.label is string && data.label.size() > 0 && data.label.size() <= 40
        && data.maxHp == 1
        && data.hp is int && data.hp >= 0 && data.hp <= 1
        && data.alive is bool
        && ((data.alive && data.hp == 1) || (!data.alive && data.hp == 0))
        && data.respawnTurn is int && data.respawnTurn >= 0
        && data.lastHitActionId is string && data.lastHitActionId.size() <= 180
        && data.lastHitByProfileId is string && (data.lastHitByProfileId == '' || validPublicId(data.lastHitByProfileId))
        && data.lastKillActionId is string && data.lastKillActionId.size() <= 180
        && data.killerProfileId is string && (data.killerProfileId == '' || validPublicId(data.killerProfileId))
        && data.wanderStep is int && data.wanderStep >= 0
        && data.lastWanderAt is timestamp
        && data.updatedAt is timestamp;
    }
    function validEnemyAttackAction(enemyId, actionId, killed) {
      let actionPath = /databases/$(database)/documents/gameActions/$(actionId);
      return existsAfter(actionPath)
        && getAfter(actionPath).data.actorProfileId == callerProfileId()
        && getAfter(actionPath).data.actionType == 'attack'
        && getAfter(actionPath).data.targetType == 'enemy'
        && getAfter(actionPath).data.targetId == enemyId
        && getAfter(actionPath).data.status == 'resolved'
        && getAfter(actionPath).data.outcome == (killed ? 'kill' : 'hit')
        && request.resource.data.respawnTurn == (killed ? getAfter(actionPath).data.resolveTurn + 1 : resource.data.respawnTurn);
    }
    function validEnemyAttackTransition(enemyId) {
      let actionId = request.resource.data.lastHitActionId;
      let killed = request.resource.data.hp == 0;
      return resource.data.alive == true
        && request.resource.data.hp == resource.data.hp - 1
        && request.resource.data.lastHitByProfileId == callerProfileId()
        && actionId.size() > 0
        && validEnemyAttackAction(enemyId, actionId, killed)
        && request.resource.data.alive == !killed
        && request.resource.data.lastKillActionId == (killed ? actionId : resource.data.lastKillActionId)
        && request.resource.data.killerProfileId == (killed ? callerProfileId() : resource.data.killerProfileId)
        && request.resource.data.x == resource.data.x
        && request.resource.data.y == resource.data.y
        && request.resource.data.wanderStep == resource.data.get('wanderStep',0)
        && request.resource.data.lastWanderAt == resource.data.get('lastWanderAt',request.resource.data.lastWanderAt);
    }
    function validEnemyRespawnTransition() {
      return callerCanContribute()
        && resource.data.alive == false
        && request.resource.data.alive == true
        && request.resource.data.hp == request.resource.data.maxHp
        && request.resource.data.respawnTurn == 0
        && request.resource.data.lastHitActionId == ''
        && request.resource.data.lastHitByProfileId == ''
        && request.resource.data.killerProfileId == ''
        && request.resource.data.lastKillActionId == resource.data.lastKillActionId
        && enemyAtSpawn(request.resource.data)
        && request.resource.data.wanderStep == resource.data.get('wanderStep',0)
        && request.resource.data.lastWanderAt is timestamp;
    }
    function validEnemyWanderTransition() {
      return callerCanContribute()
        && resource.data.alive == true
        && request.resource.data.alive == resource.data.alive
        && request.resource.data.hp == resource.data.hp
        && request.resource.data.respawnTurn == resource.data.respawnTurn
        && request.resource.data.lastHitActionId == resource.data.lastHitActionId
        && request.resource.data.lastHitByProfileId == resource.data.lastHitByProfileId
        && request.resource.data.lastKillActionId == resource.data.lastKillActionId
        && request.resource.data.killerProfileId == resource.data.killerProfileId
        && request.resource.data.x >= resource.data.x - 3.5
        && request.resource.data.x <= resource.data.x + 3.5
        && request.resource.data.y >= resource.data.y - 3.5
        && request.resource.data.y <= resource.data.y + 3.5
        && request.resource.data.wanderStep == resource.data.get('wanderStep',0) + 1
        && resource.data.lastWanderAt is timestamp
        && request.resource.data.lastWanderAt == request.time
        && request.time >= resource.data.lastWanderAt + duration.value(12, 's');
    }
    function validEnemyWanderMigration() {
      return resource.data.alive == request.resource.data.alive
        && resource.data.hp == request.resource.data.hp
        && resource.data.x == request.resource.data.x
        && resource.data.y == request.resource.data.y
        && resource.data.respawnTurn == request.resource.data.respawnTurn
        && resource.data.lastHitActionId == request.resource.data.lastHitActionId
        && resource.data.lastHitByProfileId == request.resource.data.lastHitByProfileId
        && resource.data.lastKillActionId == request.resource.data.lastKillActionId
        && resource.data.killerProfileId == request.resource.data.killerProfileId
        && request.resource.data.wanderStep == 0
        && request.resource.data.lastWanderAt is timestamp;
    }
    match /gameEnemies/{enemyId} {
      allow read: if signedIn();
      allow create: if callerCanContribute()
        && validGameEnemy(request.resource.data)
        && enemyId == request.resource.data.worldId + '__' + request.resource.data.enemyKey
        && enemyAtSpawn(request.resource.data)
        && request.resource.data.hp == 1
        && request.resource.data.alive == true
        && request.resource.data.respawnTurn == 0
        && request.resource.data.lastHitActionId == ''
        && request.resource.data.lastHitByProfileId == ''
        && request.resource.data.lastKillActionId == ''
        && request.resource.data.killerProfileId == ''
        && request.resource.data.wanderStep == 0;
      allow update: if callerCanContribute()
        && validGameEnemy(request.resource.data)
        && request.resource.data.worldId == resource.data.worldId
        && request.resource.data.enemyKey == resource.data.enemyKey
        && request.resource.data.type == resource.data.type
        && request.resource.data.label == resource.data.label
        && request.resource.data.maxHp == resource.data.maxHp
        && (validEnemyAttackTransition(enemyId) || validEnemyRespawnTransition() || validEnemyWanderTransition() || validEnemyWanderMigration());
      allow delete: if false;
    }

    // ============================================================
    // E.R.A.S. GLOBAL-TURN DECLARATIONS
    // Attacks/interactions are declarations during the live minute.
    // The client treats resolveTurn as the shared marker and lets the
    // declaring player cancel until that marker is reached.
    // ============================================================
    function validGameActionType(value) { return value in ['attack','interact']; }
    function validGameActionTargetType(value) { return value in ['profile','object','enemy']; }
    function validGameActionOutcome(value) { return value in ['','cancelled','resolved','interact','hit','kill','miss']; }
    function validGameActionStatus(value) { return value in ['queued','cancelled','resolved']; }
    function validGameAction(data) {
      return data.keys().hasOnly(['worldId','actorProfileId','actionType','targetType','targetId','targetLabel','declaredTurn','resolveTurn','status','outcome','createdAt','updatedAt','resolvedAt'])
        && validWorldId(data.worldId)
        && validPublicId(data.actorProfileId) && profileExists(data.actorProfileId)
        && validGameActionType(data.actionType)
        && validGameActionTargetType(data.targetType)
        && data.targetId is string && data.targetId.size() > 0 && data.targetId.size() <= 180
        && (data.targetType != 'profile' || (validPublicId(data.targetId) && profileExists(data.targetId)))
        && (data.targetType != 'enemy' || (exists(/databases/$(database)/documents/gameEnemies/$(data.targetId)) && get(/databases/$(database)/documents/gameEnemies/$(data.targetId)).data.worldId == data.worldId))
        && data.targetLabel is string && data.targetLabel.size() > 0 && data.targetLabel.size() <= 80
        && data.declaredTurn is int && data.declaredTurn >= 1
        && data.resolveTurn is int && data.resolveTurn == data.declaredTurn + 1
        && validGameActionStatus(data.status)
        && validGameActionOutcome(data.get('outcome',''))
        && ((data.status == 'queued' && data.get('outcome','') == '')
          || (data.status == 'cancelled' && data.get('outcome','') == 'cancelled')
          || (data.status == 'resolved' && data.get('outcome','') in ['resolved','interact','hit','kill','miss']))
        && data.createdAt is timestamp && data.updatedAt is timestamp
        && validOptionalTimestamp(data.resolvedAt)
        && ((data.status == 'resolved' && data.resolvedAt != null) || (data.status != 'resolved' && data.resolvedAt == null));
    }
    match /gameActions/{actionId} {
      allow read: if signedIn();
      allow create: if callerCanContribute()
        && isCallerProfile(request.resource.data.actorProfileId)
        && request.resource.data.status == 'queued'
        && request.resource.data.get('outcome','') == ''
        && request.resource.data.resolvedAt == null
        && validGameAction(request.resource.data);
      allow update: if callerCanContribute()
        && isCallerProfile(resource.data.actorProfileId)
        && request.resource.data.worldId == resource.data.worldId
        && request.resource.data.actorProfileId == resource.data.actorProfileId
        && request.resource.data.actionType == resource.data.actionType
        && request.resource.data.targetType == resource.data.targetType
        && request.resource.data.targetId == resource.data.targetId
        && request.resource.data.targetLabel == resource.data.targetLabel
        && request.resource.data.declaredTurn == resource.data.declaredTurn
        && request.resource.data.resolveTurn == resource.data.resolveTurn
        && request.resource.data.createdAt == resource.data.createdAt
        && resource.data.status == 'queued'
        && request.resource.data.status in ['cancelled','resolved']
        && validGameAction(request.resource.data);
      // Action documents double as the rolling game log. Actors may remove
      // their own declarations at any time. Any contributing signed-in player
      // may prune declarations after ten minutes so active worlds never grow
      // an unbounded action-history collection.
      allow delete: if isCallerProfile(resource.data.actorProfileId)
        || (callerCanContribute()
          && resource.data.createdAt is timestamp
          && resource.data.createdAt < request.time - duration.value(10, 'm'));
    }

    // LEGACY v0.4 DATA QUARANTINE. Old UID-bearing documents are never public.
    match /users/{uid} { allow read, delete: if ownAuth(uid); allow create, update: if false; }
    match /posts/{id} { allow read, delete: if signedIn() && resource.data.authorUid == request.auth.uid; allow create, update: if false; }
    match /objects/{id} { allow read, delete: if signedIn() && resource.data.authorUid == request.auth.uid; allow create, update: if false; }
    match /spaces/{id} { allow read, delete: if signedIn() && resource.data.ownerUid == request.auth.uid; allow create, update: if false; }
    match /channels/{id} { allow read, delete: if signedIn() && resource.data.ownerUid == request.auth.uid; allow create, update: if false; }
    match /comments/{id} { allow read, delete: if signedIn() && resource.data.authorUid == request.auth.uid; allow create, update: if false; }
    match /reactions/{id} { allow read, delete: if signedIn() && resource.data.userUid == request.auth.uid; allow create, update: if false; }
    match /follows/{id} { allow read, delete: if signedIn() && resource.data.userUid == request.auth.uid; allow create, update: if false; }
    match /connections/{id} { allow read, delete: if signedIn() && resource.data.authorUid == request.auth.uid; allow create, update: if false; }
    match /postLinks/{id} { allow read, delete: if signedIn() && resource.data.authorUid == request.auth.uid; allow create, update: if false; }

    match /{document=**} { allow read, write: if false; }
  }
}
